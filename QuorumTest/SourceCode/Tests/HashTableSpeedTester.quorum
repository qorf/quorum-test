package Libraries.Language.Compile.Test

use Libraries.Testing.QuorumTest
use Libraries.Testing.ScriptCheck
use Libraries.Containers.Array

/*
    How much work HashTable does, never how long it takes: a time limit
    passes on one machine and fails on another. The scripts check what is
    the same everywhere: how keys spread over the table's buckets
    (GetBucketsInUse against the number of items, so keys that all land in
    a few buckets fail), how full the table gets, and, with counted keys
    (Support/CountedKey and KeyCounter), how many hash codes and key
    comparisons each operation needs. Add, GetValue, HasKey, RemoveKey,
    add/remove churn, walking keys and values, Copy, and a comparison with
    Array and List searching. Runs on bytecode and JavaScript. Not on
    Python: loops of 50,000 to 100,000 steps are slow there, though the
    counts would be the same.
*/
class HashTableSpeedTester
    QuorumTest suite = undefined
    ScriptCheck scripts
    text path = "Scripts/HashTableSpeed/Pass/"

    action Test
        scripts:SetSuite(suite)
        Array<text> counted
        counted:Add("Scripts/HashTableSpeed/Support/KeyCounter.quorum")
        counted:Add("Scripts/HashTableSpeed/Support/CountedKey.quorum")
        scripts:Check(path + "AddIntegerKeys", true, false)
        scripts:Check(path + "AddLongTextKeys", true, false)
        scripts:Check(path + "AddRemoveChurn", counted, true, false)
        scripts:Check(path + "AddTextKeys", true, false)
        scripts:Check(path + "CompareWithArrayAndList", counted, true, false)
        scripts:Check(path + "CopyBigTable", counted, true, false)
        scripts:Check(path + "IterateKeysValues", counted, true, false)
        scripts:Check(path + "LookupKeys", counted, true, false)
        scripts:Check(path + "RemoveKeys", counted, true, false)
    end

    action GetName returns text
        return "HashTable Speed Tests"
    end

    action GetCompilerTestSuite returns QuorumTest
        return suite
    end

    action SetCompilerTestSuite(QuorumTest suite)
        me:suite = suite
    end
end
