    /*
        Gets everything ready before the first test: clears the output
        folder, scans the standard library, and gets the pinned JDK, Node.js
        and the JavaScript snapshot. Main calls it, after any settings below
        have been made, so a linear run (Console) is the same as before.
    */
    private action SetUp
        isSetUp = true
        //delete the output folder to start the testing fresh
        File rootTestFolder
        rootTestFolder:SetPath(outputFolder)
        if rootTestFolder:Exists()
            rootTestFolder:Delete(true)
        end

        File standardLibrary
        standardLibrary:SetPath(STANDARD_LIBRARY_LOCATION)
        File outputLocation
        outputLocation:SetPath(STANDARD_LIBRARY_OUTPUT)
        Compiler compiler
        Log("Starting Test Suite: " + compiler:GetVersion())
        library:SetLocation(standardLibrary)
        library:SetCachingLibraryOpcodes(true)
        library:SetOutputFolder(outputLocation)
        Log("Scanning Standard Library")
        library:Scan()

        if testBytecode and javaLocation = undefined
            javaLocation = tools:GetJava()
            LogToolMessages()
            if javaLocation = undefined
                Log("Using java from the PATH, not the pinned JDK.")
                javaLocation = "java"
            end
        end

        if testJavaScript and nodeLocation = undefined
            nodeLocation = tools:GetNode()
            LogToolMessages()
            if nodeLocation = undefined
                nodeLocation = FindNode()
            end
        end

        if testJavaScript and snapshotPath not= ""
            File blob
            blob:SetAbsolutePath(snapshotPath)
            if blob:Exists()
                useSnapshot = true
            else
                snapshotPath = ""
            end
        end

        File jsStandardLibrary
        jsStandardLibrary:SetPath("Run/QuorumStandardLibrary.js")
        if not testJavaScript
            Log("JavaScript testing is off.")
        elseif useSnapshot
            Log("Using the shared JavaScript standard library snapshot")
        elseif nodeLocation not= undefined and jsStandardLibrary:Exists()
            text built = tools:BuildSnapshot(nodeLocation, jsStandardLibrary, outputFolder + "/Run")
            LogToolMessages()
            if built not= undefined
                snapshotPath = built
                useSnapshot = true
                Log("Built the JavaScript standard library snapshot")
            else
                Log("Could not build the JavaScript snapshot, so each test loads the whole JavaScript standard library.")
                Log("Reading JavaScript Standard Library")
                javascriptStandardLibraryText = jsStandardLibrary:Read()
            end
        elseif nodeLocation not= undefined
            Log("Cannot find Run/QuorumStandardLibrary.js. Turning off JavaScript testing.")
            testJavaScript = false
        else
            Log("Cannot find Node.js. Turning off JavaScript testing.")
            testJavaScript = false
        end
        Log("Loading Complete")
        Log("")
    end

    /* Logs what ToolSetup reported, then clears it. */
    private action LogToolMessages
        Array<text> messages = tools:GetMessages()
        integer i = 0
        repeat while i < messages:GetSize()
            Log(messages:Get(i))
            i = i + 1
        end
        tools:EmptyMessages()
    end

    /* The folder the test programs are written to and run from, such as Output2. */
    action SetOutputFolder(text folder)
        outputFolder = folder
    end

    /* The folder test programs run in, two levels below the project. */
    action SetProgramFolder(text folder)
        programFolder = folder
    end

    /* The folder a test program runs in: the program folder if set, otherwise its own Run folder. */
    private action GetProgramDirectory(File runFolder) returns File
        File directory
        if programFolder = ""
            directory:SetAbsolutePath(runFolder:GetAbsolutePath())
        else
            File folder
            folder:SetPath(programFolder)
            directory:SetAbsolutePath(folder:GetAbsolutePath())
        end
        return directory
    end

    /* The folder Result.txt, Fail.txt, progress.json and result.json go to. */
    action SetResultsFolder(text folder)
        resultsFolder = folder
    end

    /* Adds a tester to run, by its TesterCatalog key. With none added, all run. */
    action ChooseTester(text key)
        chosenTesters:Add(key, key)
    end

    /* Which back ends to test on. */
    action SetBackEnds(boolean bytecode, boolean javaScript, boolean python)
        testBytecode = bytecode
        testJavaScript = javaScript
        testPython = python
    end

    /* Whether the Matrix tester runs on Python too. */
    action SetMatrixOnPython(boolean value)
        testMatrixOnPython = value
    end

    /* Makes this a process of a parallel run, which writes progress.json and result.json. */
    action SetRunID(text identifier)
        runID = identifier
    end

    action SetShard(integer shardNumber)
        shard = shardNumber
    end

    /* The java for bytecode test programs, already found (by the runner's preparing step). */
    action SetJavaLocation(text location)
        javaLocation = location
    end

    /* The Node.js for JavaScript tests, already found. */
    action SetNodeLocation(text location)
        nodeLocation = location
    end

    /* A snapshot already built, shared by every process of a run. */
    action SetSnapshotPath(text path)
        snapshotPath = path
    end

    private action GetCurrentTestPassText returns text
        integer currentPass = tester:GetPassingSize()
        integer currentTotal = tester:GetSize()

        integer passThisTest = currentPass - previousPass
        integer totalThisTest = currentTotal - previousTotal

        previousPass = tester:GetPassingSize()
        previousTotal = tester:GetSize()

        return ": " + passThisTest + "/" + totalThisTest
    end

    private action FindNode returns text
        text location = undefined

        Properties prop
        if prop:IsWindows()
            File nodeLoc
            nodeLoc:SetAbsolutePath(NODE_WINDOWS)
            if nodeLoc:Exists()
                location = NODE_WINDOWS
            end
        elseif prop:IsMac()
            File nodeLoc
            nodeLoc:SetAbsolutePath(NODE_MAC)
            if nodeLoc:Exists()
                location = NODE_MAC
            end
        end
        return location
    end

