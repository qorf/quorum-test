    /*
        Whether the Matrix tester runs on Python. With Python, each Matrix test
        compiles most of the library (Matrix keeps its numbers in a DataFrame,
        which reaches the game engine), so it takes as long as everything
        else together. On by default here; the runner window turns it off
        unless its checkbox is checked.
    */
    boolean testMatrixOnPython = true
    Library library
    /*
        The standard library the scripts are compiled against. quorum-test sits
        next to quorum-language, and the program runs from the QuorumTest folder.
    */
    constant text STANDARD_LIBRARY_LOCATION = "../../quorum-language/Quorum/Library/Standard"
    constant text STANDARD_LIBRARY_OUTPUT = "../../quorum-language/Quorum/Library/Compiled"
    /*
        Where the test programs are written and run, and where Result.txt and
        Fail.txt go. A process of a parallel run gets its own of each. The
        output folder must stay one level below the project, because the
        test programs read ../../Scripts from its Run folder.
    */
    text outputFolder = "Output"
    text resultsFolder = "Results"
    /*
        The folder test programs run in. Empty means the compiler's Run
        folder (Output/Run). A process of a parallel run compiles into
        Output/ProcessN, whose Run folder is one level too deep for the
        programs' ../../Scripts paths, so its programs run in Output/ProcessN.
    */
    text programFolder = ""
    /* The runner window writes this file to ask every process of a run to stop. */
    constant text STOP_FILE = "Results/stop"
