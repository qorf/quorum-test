            statisticsChecks:Test()
            FinishTester(statisticsChecks:GetName())
        end

        text EOL = ""
        EOL = EOL:GetCarriageReturn() + EOL:GetLineFeed()

        DateTime date2
        finish = date2:GetEpochTime()
        number totalTime = finish - start
        totalTime = totalTime / 1000.0
        number bytecodePercentage = math:Round((bytecodePassed  * 100.0) / (totalBytecode * 1.0), 3)
        number javaScriptPercentage = math:Round((javaScriptPassed  * 100.0) / (totalJavaScript * 1.0), 3)

        Log("Finished in " + totalTime + " seconds.")
        Log("")
        Log("Summary")
        integer passedSuite = tester:GetPassingSize()
        integer sizeSuite = tester:GetSize()
        number percentSuite = math:Round((passedSuite  * 100.0) / (sizeSuite * 1.0), 3)
        Log(passedSuite + " of " + sizeSuite + ", " + percentSuite + "%.")

        if passedSuite not= sizeSuite
            Log("Outputting failed tests.")
            Iterator<Test> iterator = tester:GetFailedTestsIterator()
            i = 1
            repeat while iterator:HasNext()
                Test test = iterator:Next()
                Log(i + ": " + test:GetName())
                i = i + 1
            end
        else
            Log("All Tests Pass")
        end
        WriteResults()

        text status = "finished"
        if stopRequested
            status = "cancelled"
        end
        WriteState(status, RESULT_FILE)
    end

    /*
        Returns true if the tester should run: it was chosen (or none were),
        and no stop was asked for. Then it is noted as the current tester.
    */
    private action StartTester(text key) returns boolean
        if not chosenTesters:IsEmpty() and not chosenTesters:HasKey(key)
            return false
        end
        if IsStopRequested()
            return false
        end
        currentTester = key
        DateTime clock
        testerStart = clock:GetEpochTime()
        testerFailedBefore = tester:GetFailingSize()
        WriteState("running", PROGRESS_FILE)
        return true
    end

    /* Logs the tester's count and records it, with its time and failures, for progress.json and result.json. */
    private action FinishTester(text label)
        integer testerPassed = tester:GetPassingSize() - previousPass
        integer testerTotal = tester:GetSize() - previousTotal
        DateTime clock
        number seconds = (clock:GetEpochTime() - testerStart) / 1000.0
        Log(label + GetCurrentTestPassText())

        if testersFinished > 0
            testersJson:Append(", ")
        end
        testersJson:Append("{" + json:Pair("name", json:Quote(currentTester)) + ", " +
            json:Pair("label", json:Quote(label)) + ", " +
            json:Pair("passed", "" + testerPassed) + ", " +
            json:Pair("total", "" + testerTotal) + ", " +
            json:Pair("seconds", "" + seconds) + ", " +
            json:Pair("failures", GetFailuresJson(testerFailedBefore)) + "}")
        testersFinished = testersFinished + 1
        currentTester = ""
        WriteState("running", PROGRESS_FILE)
    end

    /* The failed tests after the first skip ones, as a JSON array. */
    private action GetFailuresJson(integer skip) returns text
        TextBuilder builder
        builder:Append("[")
        Iterator<Test> iterator = tester:GetFailedTestsIterator()
        integer index = 0
        integer written = 0
        repeat while iterator:HasNext()
            Test test = iterator:Next()
            if index >= skip
                if written > 0
                    builder:Append(", ")
                end
                builder:Append("{" + json:Pair("file", json:Quote(test:GetName())) + ", " +
                    json:Pair("backEnd", json:Quote(GetBackEndOf(test))) + ", " +
                    json:Pair("reason", json:Quote(GetReason(test))) + "}")
                written = written + 1
            end
            index = index + 1
        end
        builder:Append("]")
        return builder:ToText()
    end

    /*
        For a process of a parallel run only: writes progress.json (while it
        runs) or result.json (last of all) into its results folder, safely,
        so the runner window never reads half a file.
    */
    private action WriteState(text status, text fileName)
        if runID = ""
            return now
        end
        DateTime clock
        number seconds = (clock:GetEpochTime() - runStart) / 1000.0
        integer currentPassed = 0
        integer currentTotal = 0
        if currentTester not= ""
            currentPassed = tester:GetPassingSize() - previousPass
            currentTotal = tester:GetSize() - previousTotal
        end
        text value = "{" + json:Pair("run", json:Quote(runID)) + ", " +
            json:Pair("shard", "" + shard) + ", " +
            json:Pair("status", json:Quote(status)) + ", " +
            json:Pair("current", json:Quote(currentTester)) + ", " +
            json:Pair("currentPassed", "" + currentPassed) + ", " +
            json:Pair("currentTotal", "" + currentTotal) + ", " +
            json:Pair("testersFinished", "" + testersFinished) + ", " +
            json:Pair("passed", "" + tester:GetPassingSize()) + ", " +
            json:Pair("total", "" + tester:GetSize()) + ", " +
            json:Pair("seconds", "" + seconds) + ", " +
            json:Pair("testers", "[" + testersJson:ToText() + "]") + "}"
        lastProgress = clock:GetEpochTime()
        json:WriteSafely(resultsFolder + "/" + fileName, value)
    end

    /*
        True once the runner window has written Results/stop. Only a process
        of a parallel run checks; the remaining tests are then skipped.
    */
    private action IsStopRequested returns boolean
        if stopRequested
            return true
        end
        if runID = ""
            return false
        end
        File stop
        stop:SetPath(STOP_FILE)
        if stop:Exists()
            stopRequested = true
            Log("Stopped: " + STOP_FILE + " was found.")
        end
        return stopRequested
    end

    /* Writes a line to the console and keeps a copy of it for Result.txt. */
    private action Log(text line)
        output line
        text lineFeed = ""
        log:Append(line)
        log:Append(lineFeed:GetLineFeed())
    end

    /* Adds a reason to a result, on its own line, for Fail.txt. */
    private action AddReason(CompilerTestResult result, text reason)
        if result:errorMessage = ""
            result:errorMessage = reason
        else
            text lineFeed = ""
            result:errorMessage = result:errorMessage + lineFeed:GetLineFeed() + reason
        end
    end

    private action GetBackEnd(CompilerTestResult result) returns text
        if result:isPythonTest
            return "Python"
        elseif result:isBytecodeTest
            return "Bytecode"
        elseif result:isJavaScriptTest
            return "JavaScript"
        end
        return "Unknown"
    end

    /* The back end of any failed test; science tests run inside this process. */
    private action GetBackEndOf(Test test) returns text
        if test is CompilerTestResult
            CompilerTestResult result = cast(CompilerTestResult, test)
            return GetBackEnd(result)
        end
        return "Science"
    end

    /* Why a test failed, for Fail.txt and result.json. */
    private action GetReason(Test test) returns text
        text reason = ""
        if test is CompilerTestResult
            CompilerTestResult result = cast(CompilerTestResult, test)
            reason = result:errorMessage
        else
            reason = test:GetErrorMessage()
            if reason = ""
                reason = "A check failed or the test stopped with an error. Run it alone for details."
            end
        end
        if reason = ""
            reason = "No details were recorded."
        end
        return reason
    end

    /*
        Writes Result.txt (everything the console showed) and Fail.txt (each
        failed test and why) in the results folder. Both are overwritten on
        each run.
    */
    private action WriteResults
        text lineFeed = ""
        lineFeed = lineFeed:GetLineFeed()
        DateTime runTime
        text header = "Quorum test results, " + runTime:ToText() + lineFeed + lineFeed

        File resultFile
        resultFile:SetPath(resultsFolder + "/Result.txt")
        resultFile:GetParentDirectory():CreateDirectories()
        resultFile:Write(header + log:ToText())

        TextBuilder failures
        failures:Append(header)
        integer failedCount = tester:GetFailingSize()
        if failedCount = 0
            failures:Append("All tests pass." + lineFeed)
        else
            failures:Append(failedCount + " failed." + lineFeed + lineFeed)
            Iterator<Test> iterator = tester:GetFailedTestsIterator()
            repeat while iterator:HasNext()
                Test test = iterator:Next()
                failures:Append(test:GetName() + " (" + GetBackEndOf(test) + ")" + lineFeed)
                Array<text> reasonLines = GetReason(test):Split(lineFeed)
                Iterator<text> reasonIterator = reasonLines:GetIterator()
                repeat while reasonIterator:HasNext()
                    failures:Append("    " + reasonIterator:Next() + lineFeed)
                end
                failures:Append(lineFeed)
            end
        end

        File failFile
        failFile:SetPath(resultsFolder + "/Fail.txt")
        failFile:Write(failures:ToText())
    end


    action Test(Array<File> files, Array<text> reply)
        if IsStopRequested()
            return now
        end
        if testBytecode = false
            return now
        end
        CompilerTestResult result
        check
            result = RunTestFile(files)
            TestResult(result, reply)
        detect e
            text message = e:GetErrorMessage()
            File failedFile = files:Get(0)
            Log("    " + failedFile:GetPath() + " stopped with an error: " + message)
            AddReason(result, "Stopped with an error: " + message)
            result:SetName(failedFile:GetPath())
            result:stackTrace = e:GetStackTrace()
            //an error while running or checking is always a failure
            result:passed = false
            result:SetPassed(false)
        end
        result:isBytecodeTest = true
        Add(result)
        tester:Add(result)
    end

    private action TestResult(CompilerTestResult result, Array<text> reply)
        result:Check(result:ranWithoutError, true)
        if not result:ranWithoutError
           if result:errorMessage = ""
               //the program ran, but wrote to the error stream
               text lineFeedText = ""
               lineFeedText = lineFeedText:GetLineFeed()
               AddReason(result, "The program wrote to the error stream:")
               AddReason(result, javascriptErrorOutput:Replace(JAVASCRIPT_DELIMITER, lineFeedText))
           end
           Log("failed here: " + result:errorMessage)
        end
        if result:ranWithoutError
            Array<text> lines = result:lines
            Iterator<text> lineIt = lines:GetIterator()
            integer n = lines:GetSize()
            integer i = 0
            result:passed = true
            if lines:GetSize() not= reply:GetSize()
                Log("diff sizes")
                AddReason(result, "Expected " + reply:GetSize() + " lines of output, got " + lines:GetSize() + ".")
                result:passed = false
                //compare only the lines both have, so a size difference
                //is reported instead of throwing
                if reply:GetSize() < n
                    n = reply:GetSize()
                end
            else
                result:passed = true
            end
            repeat n times
                if lines:Get(i) not= reply:Get(i)
                    //leaving this here as it is convenient for testing.
                    Log("Line '" + lines:Get(i) + "'" + "Answer '" + reply:Get(i) + "'")
                    AddReason(result, "Line " + (i + 1) + ": got '" + lines:Get(i) + "', expected '" + reply:Get(i) + "'")
                    result:passed = false
                end
                i = i + 1
            end
            result:Check(result:passed, true)
        end
    end

    action TestPython(Array<File> files, Array<text> reply)
        if IsStopRequested()
            return now
        end
        if testPython = false
            return now
        end
        if not testMatrixOnPython and currentTester = "Matrix"
            return now
        end
        CompilerTestResult result
        check
            result = RunPythonTestFile(files)
            TestResult(result, reply)
        detect e
            text message = e:GetErrorMessage()
            result:errorMessage = message
            result:stackTrace = e:GetStackTrace()
            File testFile
            testFile = files:Get(0)
            result:SetName(testFile:GetPath())
            result:passed = false
            result:SetPassed(false)
        end
        result:isPythonTest = true
        Add(result)
        tester:Add(result)
    end

    action RunPythonTestFile(Array<File> files) returns CompilerTestResult
        CompilerTestResult result = undefined
        Compiler compiler  = GetDefaultCompiler()

        TranslateConstants constants
        constants:SetUserCodeAsynchronous(false)
        CompilerRequest request
        request:main = files:Get(0)
        request:isWebRequest = false
        request:library = library
        request:SetOutputType(request:PYTHON)
        request:files = files

        CompilerResult compilerResult = compiler:Compile(request)
        CompilerErrorManager manager = compilerResult:compilerErrorManager

        File testFile
        testFile = files:Get(0)
        CompilerProfiler profiler = compiler:GetCompilerProfiler()
        summaryProfiler:Add(profiler)

        if manager:IsCompilationErrorFree() //run the program
            text convertedPython = compilerResult:convertedPython
            result = RunPython(convertedPython)
        else
            CompilerTestResult result2
            result = result2
            result:errorMessage = "Compilation had errors:" + JAVASCRIPT_DELIMITER:GetLineFeed() + manager:GetCompilerErrorsAsText()
        end
        result:SetName(testFile:GetPath())
        return result
    end

