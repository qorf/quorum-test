use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Behaviors.Controls.ScrollableControlMouseScrollBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Events.MouseEvent
use Libraries.System.DateTime

/*
    TEMPORARY, for finding why mouse wheel scrolling sometimes pauses: prints
    each wheel event's time and amount, then scrolls as the control would
    have. Remove it, and the lines in Main marked TEMPORARY, when done.
*/
class WheelTimingBehavior is Behavior
    ScrollableControlMouseScrollBehavior scroll
    text place = ""

    // Which control this is on, for the printed lines.
    action SetPlace(text value)
        place = value
    end

    action Run(BehaviorEvent event)
        MouseEvent mouse = event:GetMouseEvent()
        if mouse not= undefined
            DateTime clock
            output "wheel on " + place + " at " + clock:GetEpochTime() + " ms, amount " + mouse:scrollAmount
        end
        scroll:Run(event)
    end
end
