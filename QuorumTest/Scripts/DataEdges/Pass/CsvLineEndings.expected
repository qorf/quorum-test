Read(a,b\nc,d) rows = 2: [a][b] | [c][d]
Read(a,b\r\nc,d) rows = 2: [a][b] | [c][d]
Read(a,b\rc,d) rows = 2: [a][b] | [c][d]
Read(a,b\n) rows = 1: [a][b]
Read(a,b\r\n) rows = 1: [a][b]
Read(a,b\r) rows = 1: [a][b]
Read(a,b\r\nc,d\r\n) rows = 2: [a][b] | [c][d]
Read(a,b\rc,d\r) rows = 2: [a][b] | [c][d]
Read(a,"b"\r\nc,d) rows = 2: [a][b] | [c][d]
