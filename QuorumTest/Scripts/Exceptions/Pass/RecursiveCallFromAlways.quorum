/**
Expected output:
always 2
always 1
detect bottom
always 0

Each call's always block calls the action again with a smaller depth, until
depth 0. At depth 0 the check block raises an error; the detect block
returns, and the always block still runs, but has nothing left to call.
*/

class Main
    action Main
        Count(2)
    end

    action Count(integer depth)
        check
            if depth = 0
                alert("bottom")
            end
        detect e
            output "detect " + e:GetErrorMessage()
            return now
        always
            output "always " + depth
            if depth > 0
                Count(depth - 1)
            end
        end
    end
end
