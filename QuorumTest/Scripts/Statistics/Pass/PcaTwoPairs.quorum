use Libraries.Compute.Math
use Libraries.Compute.Vector
use Libraries.Compute.Statistics.DataFrame
use Libraries.Compute.Statistics.Tests.PrincipalComponentAnalysis
use Libraries.Compute.Statistics.Reporting.PrincipalComponentAnalysisResult

/*
PrincipalComponentAnalysis on two pairs of variables: each pair correlates
0.6, and the pairs don't correlate with each other. The eigenvalues are
1.6 twice and 0.4 twice. With 2 components the communality is 0.8 for
every variable (the same for any choice of the two components), and the
variance accounted for is 3.2 in total. Rotated with varimax
(UseUncorrelatedRotation) or oblimin (UseCorrelatedRotation), the
simplest structure is exact: each variable loads 0.894427 on its pair's
component and 0 on the other, and rotation doesn't change communality.

The data columns are built from the 8-point Hadamard vectors (+1 and -1 in
fixed patterns, each summing to 0 and orthogonal to the others), so their
correlations are exact and the answers can be worked out by hand.
PrincipalComponentAnalysis uses the correlation matrix. Only values that
don't depend on arbitrary choices are printed: a loading's sign is a
convention, so loadings are shown as absolute values, and where eigenvalues
repeat only values that are the same for every choice of components are
checked. Values are rounded to 6 places.
*/
class Main
    Math math

    action Clean(number value) returns number
        return math:Round(value, 6)
    end

    action ShowVector(Vector values) returns text
        text result = "["
        integer i = 0
        repeat while i < values:GetSize()
            if i > 0
                result = result + ", "
            end
            result = result + Clean(values:Get(i))
            i = i + 1
        end
        return result + "]"
    end

    /* The absolute loading of a variable (row) on a component (column). */
    action Loading(PrincipalComponentAnalysisResult result, integer row, integer component) returns number
        DataFrame loadings = result:GetFactorLoadings()
        return math:AbsoluteValue(loadings:GetColumn(component):GetAsNumber(row))
    end

    action Signed(PrincipalComponentAnalysisResult result, integer row, integer component) returns number
        DataFrame loadings = result:GetFactorLoadings()
        return loadings:GetColumn(component):GetAsNumber(row)
    end

    action Load(text csv) returns DataFrame
        DataFrame frame
        frame:LoadFromCommaSeparatedValue(csv)
        frame:SelectAllColumns()
        return frame
    end

    action Main
        text lf = ""
        lf = lf:GetLineFeed()
        text data = "v1,v2,v3,v4" + lf + "6,2,6,2" + lf + "-2,-6,-2,-6" + lf + "2,6,-2,-6" + lf + "-6,-2,6,2" + lf + "6,2,2,6" + lf + "-2,-6,-6,-2" + lf + "2,6,-6,-2" + lf + "-6,-2,2,6"
        check
            PrincipalComponentAnalysis pca
            pca:Calculate(Load(data), 2)
            PrincipalComponentAnalysisResult result = pca:GetResult()
            output "Two pairs: eigenvalues " + ShowVector(result:GetEigenvalues())
            output "Two pairs, 2 components: communality " + ShowVector(result:GetCommunality()) + ", total variance accounted for " + Clean(Total(result:GetVarianceAccountedFor()))
        detect e
            output "Two pairs unexpected error: " + e:GetErrorMessage()
        end
        ShowRotated("varimax", data, true)
        ShowRotated("oblimin", data, false)
    end

    action Total(Vector values) returns number
        number sum = 0
        integer i = 0
        repeat while i < values:GetSize()
            sum = sum + values:Get(i)
            i = i + 1
        end
        return sum
    end

    /* The component a variable loads on most: 0 or 1. */
    action StrongerComponent(PrincipalComponentAnalysisResult result, integer row) returns integer
        if Loading(result, row, 0) >= Loading(result, row, 1)
            return 0
        end
        return 1
    end

    action ShowRotated(text name, text data, boolean uncorrelated)
        check
            PrincipalComponentAnalysis pca
            if uncorrelated
                pca:UseUncorrelatedRotation()
            else
                pca:UseCorrelatedRotation()
            end
            pca:Calculate(Load(data), 2)
            PrincipalComponentAnalysisResult result = pca:GetResult()
            integer row = 0
            text larger = ""
            text smaller = ""
            repeat while row < 4
                integer stronger = StrongerComponent(result, row)
                if row > 0
                    larger = larger + ", "
                    smaller = smaller + ", "
                end
                larger = larger + Clean(Loading(result, row, stronger))
                smaller = smaller + Clean(Loading(result, row, 1 - stronger))
                row = row + 1
            end
            output "Two pairs, " + name + ": each variable's larger loading " + larger + ", smaller " + smaller
            output "Two pairs, " + name + ": variables 1 and 2 share a component = " + (StrongerComponent(result, 0) = StrongerComponent(result, 1)) + ", 3 and 4 = " + (StrongerComponent(result, 2) = StrongerComponent(result, 3)) + ", 1 and 3 = " + (StrongerComponent(result, 0) = StrongerComponent(result, 2))
            output "Two pairs, " + name + ": communality " + ShowVector(result:GetCommunality())
        detect e
            output "Two pairs, " + name + " unexpected error: " + e:GetErrorMessage()
        end
    end
end
