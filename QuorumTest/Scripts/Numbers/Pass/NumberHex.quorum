/*
    Number:GetHex gives the hex representation of the number. The
    documentation does not give the format; the expectation is Java's
    Double.toHexString (for example 1.0 gives 0x1.0p0 and -2.5 gives
    -0x1.4p1), the format the Java plugin uses. Each case runs on a number
    primitive and on a Number object.
*/
class Main
    action Main
        number helper = 0.0
        Show("1.0", 1.0)
        Show("0.0", 0.0)
        Show("-2.5", -2.5)
        Show("0.5", 0.5)
        Show("255.0", 255.0)
        Show("0.1", 0.1)
        Show("positive infinity", helper:GetPositiveInfinityValue())
        Show("NaN", helper:GetNotANumberValue())
    end

    action Show(text label, number value)
        check
            output "GetHex(" + label + ") = [" + value:GetHex() + "]"
        detect e
            output "GetHex(" + label + ") unexpected error: " + e:GetErrorMessage()
        end
        Number object
        object:SetValue(value)
        check
            output "Number GetHex(" + label + ") = [" + object:GetHex() + "]"
        detect e
            output "Number GetHex(" + label + ") unexpected error: " + e:GetErrorMessage()
        end
    end
end
