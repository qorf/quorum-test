package Libraries.Multitasking

/*
    A stand-in for multitasking's Task, so these tests need neither the
    multitasking library nor its plugins. Its class and actions have the
    names the compiler knows as waiting (TranslateConstants), so the compiler
    treats them as the real ones: in JavaScript, Wait is awaited and every
    action that reaches it is async. Here Wait simply runs the task, Run and
    then Then, the first time it is called, so every back end gives the same
    output.
*/
class Task
    boolean finished = false

    action Run
    end

    action Then
    end

    action Wait
        if not finished
            finished = true
            Run()
            Then()
        end
    end

    action Wait(number milliseconds) returns boolean
        Wait()
        return true
    end

    action IsFinished returns boolean
        return finished
    end
end
