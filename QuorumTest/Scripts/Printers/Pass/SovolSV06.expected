is KlipperPrinter = false
is BambuPrinter = false
Validate() problem count = 0
GetHeatGcode() = [M140 S{BED_TEMP} ;start heating the bed\nM104 S{NOZZLE_TEMP} ;start heating the nozzle]
GetHomeGcode() = [G28 ;home all axes]
GetPrimeGcode() = [M190 S{BED_TEMP} ;wait for the bed\nM109 S{NOZZLE_TEMP} ;wait for the nozzle\nG90\nM83\nG1 Z2.0 F3000\nG1 X5 Y20 Z0.3 F5000\nG1 X5 Y120 E12 F1500 ;prime line\nG1 X5.4 Y120 F5000\nG1 X5.4 Y20 E12 F1500 ;prime line\nG1 Z2.0 F3000]
GetStartGcode() = [M140 S{BED_TEMP} ;start heating the bed\nM104 S{NOZZLE_TEMP} ;start heating the nozzle\nG28 ;home all axes\nM190 S{BED_TEMP} ;wait for the bed\nM109 S{NOZZLE_TEMP} ;wait for the nozzle\nG90\nM83\nG1 Z2.0 F3000\nG1 X5 Y20 Z0.3 F5000\nG1 X5 Y120 E12 F1500 ;prime line\nG1 X5.4 Y120 F5000\nG1 X5.4 Y20 E12 F1500 ;prime line\nG1 Z2.0 F3000]
GetEndGcode() = [G91 ;relative positioning\nG1 Z10 F600 ;lift away from the print\nG90\nG1 X0 Y{PARK_Y} F6000 ;present the print\nM104 S0 ;nozzle heater off\nM140 S0 ;bed heater off\nM107 ;fan off\nM84 ;motors off]
Describe() after SetBed(150.5, 160, 170) = [Sovol SV06: 150.5 x 160 x 170 mm, 0.4 mm nozzle, PLA at 215 C, 0.2 mm layers]
Lines(A, B) = [A\nB]
child profile GetStartGcode() = printer's = true
child profile GetText(maxNozzleTemperature) = [300]
