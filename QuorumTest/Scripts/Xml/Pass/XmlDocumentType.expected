Read(<!DOCTYPE a><a/>) events: Start(a) End(a)
Read(<!DOCTYPE a [<!ENTITY e 'hello'>]><a>&e;</a>) events: Start(a) Value[hello] End(a)
Read(<!DOCTYPE a [<!ENTITY e "hello">]><a>&e;</a>) events: Start(a) Value[hello] End(a)
Read(<!DOCTYPE a [<!ENTITY e 'v'>]><a x='&e;'/>) events: Start(a x=[v]) End(a)
Read(<!DOCTYPE a [<!ENTITY e 'two words'>]><a>[&e;]</a>) events: Start(a) Value[[two words]] End(a)
Read(<!DOCTYPE a [\n<!ENTITY one '1'>\n<!ENTITY two '2'>\n]>\n<a>&one;&two;</a>) events: Start(a) Value[12] End(a)
Read(<!DOCTYPE a [<!ENTITY e 'a>b'>]><a>&e;</a>) events: Start(a) Value[a>b] End(a)
Read(<!DOCTYPE a [<!ELEMENT a (#PCDATA)>]><a>t</a>) events: Start(a) Value[t] End(a)
Read(<?xml version='1.0'?><!DOCTYPE a [<!ENTITY e 'x'>]><a>&e;</a>) events: Start(a) Value[x] End(a)
Read(<!DOCTYPE a [<!ENTITY e '&lt;'>]><a>&e;</a>) events: Start(a) Value[<] End(a)
