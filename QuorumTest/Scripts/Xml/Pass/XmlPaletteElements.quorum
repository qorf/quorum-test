use Libraries.Data.Formats.ExtensibleMarkupReader
use Libraries.Data.Formats.MarkupListener
use Libraries.Data.Formats.Element
use Libraries.Data.Formats.AttributesImplementation

/*
A block palette using every element and attribute
BlockPaletteMarkupListener reads: palette with showAction, showControl,
showBasic, selectedPage, iconFontPath and iconFontName; basicIcon,
controlIcon, actionIcon and suggestionIcon; several pages, each with name;
icon with character, unicode, filePath, red, green, blue and alpha; banner
with title and subtitle; header, subheading, text and block.

Each case reads one small document with a new ExtensibleMarkupReader and
prints the events this listener received, in order: Start(name attr=[value]
...), Value[text] and End(name). The document in each line is written with
line feeds, tabs and carriage returns shown as \n, \t and \r.

In the source, a document is written with ` for a double quote, ^ for a line
feed, ~ for a tab and @ for a carriage return; Build turns those into the real
characters, since Quorum text literals have no escapes.

Choices where the reader's documentation is silent (from XML 1.0 and the
usual SAX conventions): one Value event for each run of character data
between two pieces of markup (tags, comments, processing instructions), with
entity references and CDATA sections inside the run; whitespace-only runs
are not reported (BlockPaletteMarkupListener treats text directly inside
palette or page as a bad file, so reporting that whitespace would reject
every palette); names are reported as written; a document that is not
well-formed must cause an error.

The expected events were worked out with Python's own XML parser (xml.sax)
and these rules, not by running the reader.
*/
class Main is MarkupListener
    text log = ""

    action Main
        Parse("<palette showAction=`false` showControl=`true` showBasic=`false` selectedPage=`Second` iconFontPath=`Fonts/Icons.ttf` iconFontName=`Icons`>^  <basicIcon><character>b</character></basicIcon>^  <controlIcon><unicode>61441</unicode></controlIcon>^  <actionIcon><filePath>Images/action.png</filePath></actionIcon>^  <suggestionIcon><character>s</character><red>0.5</red><green>0.25</green><blue>1</blue><alpha>0.75</alpha></suggestionIcon>^  <page name=`Second`><block>a</block></page>^</palette>")
        Parse("<palette>^  <page name=`First`>^    <icon><unicode>61442</unicode><red>1</red><green>0</green><blue>0</blue><alpha>1</alpha></icon>^    <banner>^      <title>Welcome</title>^      <subtitle>Start here</subtitle>^    </banner>^    <header>Output</header>^    <subheading>Saying hello</subheading>^    <text>Drag a block into the editor.</text>^    <block>output `Hello`</block>^  </page>^</palette>")
        Parse("<palette selectedPage=`Third`>^  <page name=`Second`>^    <icon><character>x</character></icon>^    <banner><title>Only a title</title></banner>^    <header>Variables</header>^    <block>integer a = 5</block>^    <block>text name = `Quorum`</block>^  </page>^  <page name=`Third`>^    <icon><filePath>Images/third.png</filePath></icon>^    <text>Nothing else here.</text>^  </page>^</palette>")
    end

    action Build(text raw) returns text
        text dq = ""
        dq = dq:GetDoubleQuote()
        text result = raw:Replace("`", dq)
        result = result:Replace("^", dq:GetLineFeed())
        result = result:Replace("~", dq:GetTab())
        result = result:Replace("@", dq:GetCarriageReturn())
        return result
    end

    action Parse(text raw)
        text xml = Build(raw)
        log = ""
        check
            ExtensibleMarkupReader reader
            reader:SetMarkupListener(me)
            reader:Read(xml)
            if log = ""
                log = " (none)"
            end
            output "Read(" + Show(xml) + ") events:" + log
        detect e
            output "Read(" + Show(xml) + ") unexpected error: " + e:GetErrorMessage()
        end
    end

    action ParseFail(text raw)
        text xml = Build(raw)
        log = ""
        check
            ExtensibleMarkupReader reader
            reader:SetMarkupListener(me)
            reader:Read(xml)
            if log = ""
                log = " (none)"
            end
            output "Read(" + Show(xml) + ") should fail but returned events:" + log
        detect e
            output "Read(" + Show(xml) + ") fails, as it should"
        end
    end


    action Show(text value) returns text
        text result = value:Replace(value:GetCarriageReturn(), "\r")
        result = result:Replace(value:GetLineFeed(), "\n")
        result = result:Replace(value:GetTab(), "\t")
        return result
    end

    action StartElement(Element element)
        text result = " Start(" + element:GetName()
        AttributesImplementation attributes = element:GetAttributes()
        integer i = 0
        repeat while i < attributes:GetSize()
            result = result + " " + attributes:GetName(i) + "=[" + Show(attributes:GetValue(i)) + "]"
            i = i + 1
        end
        log = log + result + ")"
    end

    action Value(text value)
        log = log + " Value[" + Show(value) + "]"
    end

    action EndElement(Element element)
        log = log + " End(" + element:GetName() + ")"
    end
end
