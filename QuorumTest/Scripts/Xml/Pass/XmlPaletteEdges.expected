Read(<palette>\n\t<page name="P">\n\t\t<header>Tabs</header>\n\t\t<block>a = 1</block>\n\t</page>\n</palette>) events: Start(palette) Start(page name=[P]) Start(header) Value[Tabs] End(header) Start(block) Value[a = 1] End(block) End(page) End(palette)
Read(<palette>\n    <page name="P">\n        <header>Spaces</header>\n        <block>a = 1</block>\n    </page>\n</palette>) events: Start(palette) Start(page name=[P]) Start(header) Value[Spaces] End(header) Start(block) Value[a = 1] End(block) End(page) End(palette)
Read(<palette>\r\n  <page name="P">\r\n    <header>Windows</header>\r\n    <block>a = 1</block>\r\n  </page>\r\n</palette>\r\n) events: Start(palette) Start(page name=[P]) Start(header) Value[Windows] End(header) Start(block) Value[a = 1] End(block) End(page) End(palette)
Read(<palette><page name="P"><header>One line</header><block>a = 1</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(header) Value[One line] End(header) Start(block) Value[a = 1] End(block) End(page) End(palette)
Read(<palette><page name="P"><block>output "x: " + (a + b) > 2</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[output "x: " + (a + b) > 2] End(block) End(page) End(palette)
Read(<palette><page name="P"><block>if a &lt; b and c &amp; d</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[if a < b and c & d] End(block) End(page) End(palette)
Read(<palette><page name="P"><block>a = b -> c &gt;= d</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[a = b -> c >= d] End(block) End(page) End(palette)
Read(<palette><page name="P"><header>Let's start</header></page></palette>) events: Start(palette) Start(page name=[P]) Start(header) Value[Let's start] End(header) End(page) End(palette)
Read(<palette><page name="P"><block>output "it&apos;s &quot;q&quot;"</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[output "it's "q""] End(block) End(page) End(palette)
Read(<palette><page name="P"><header>Café 😀</header><block>output "naïve 😀"</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(header) Value[Café 😀] End(header) Start(block) Value[output "naïve 😀"] End(block) End(page) End(palette)
Read(<palette><page name="P"><block>output "&#233;&#x1F600;"</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[output "é😀"] End(block) End(page) End(palette)
Read(<palette selectedPage='P'><page name='P'><block>a</block></page></palette>) events: Start(palette selectedPage=[P]) Start(page name=[P]) Start(block) Value[a] End(block) End(page) End(palette)
Read(<palette selectedPage = "P"><page name  =  "P"><block>a</block></page></palette>) events: Start(palette selectedPage=[P]) Start(page name=[P]) Start(block) Value[a] End(block) End(page) End(palette)
Read(<palette selectedPage="Data Science"><page name="Data Science"><block>a</block></page></palette>) events: Start(palette selectedPage=[Data Science]) Start(page name=[Data Science]) Start(block) Value[a] End(block) End(page) End(palette)
Read(<palette selectedPage="P" showBasic="false"\n    showControl="false"><page name="P"/></palette>) events: Start(palette selectedPage=[P] showBasic=[false] showControl=[false]) Start(page name=[P]) End(page) End(palette)
Read(<palette><page name="P">\n<block>a</block>\n<!-- the second block -->\n<block>b</block>\n</page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[a] End(block) Start(block) Value[b] End(block) End(page) End(palette)
Read(<?xml version="1.0" encoding="UTF-8"?>\n<palette><page name="P"><block>a</block></page></palette>\n) events: Start(palette) Start(page name=[P]) Start(block) Value[a] End(block) End(page) End(palette)
Read(<!-- a palette -->\n<palette><page name="P"><block>a</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[a] End(block) End(page) End(palette)
Read(<palette><page name="P"><block></block><block/></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) End(block) Start(block) End(block) End(page) End(palette)
Read(<palette><page name="x"/></palette>) events: Start(palette) Start(page name=[x]) End(page) End(palette)
Read(<palette/>) events: Start(palette) End(palette)
Read(<palette><page name="P"><block>   output 1   </block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[   output 1   ] End(block) End(page) End(palette)
Read(<palette><page name="P"><block>\toutput 1\t</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[\toutput 1\t] End(block) End(page) End(palette)
Read(<palette><page name="P"><block>repeat 3 times\n    output "hi"\nend</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[repeat 3 times\n    output "hi"\nend] End(block) End(page) End(palette)
Read(<palette><page name="P"><block>a = 1\r\nb = 2</block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[a = 1\nb = 2] End(block) End(page) End(palette)
Read(<palette><page name="P"><block><![CDATA[if a < b and c & d]]></block></page></palette>) events: Start(palette) Start(page name=[P]) Start(block) Value[if a < b and c & d] End(block) End(page) End(palette)
