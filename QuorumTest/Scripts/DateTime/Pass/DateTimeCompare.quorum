use Libraries.System.DateTime

/*
Tests IsBefore, IsAfter and Compare on parsed timestamps (the same in every
time zone). Compare returns -1 when this time is earlier, 0 when they are
the same, and 1 when it is later.
*/
class Main
    action Main
        DateTime early
        DateTime late
        DateTime same
        check
            early:ParseTimestamp("2020-05-01T08:00:00")
            late:ParseTimestamp("2020-05-01T08:00:01")
            same:ParseTimestamp("2020-05-01T08:00:00")
            output "Parsed 2020-05-01T08:00:00 (early, same) and 2020-05-01T08:00:01 (late)"
        detect e
            output "ParseTimestamp unexpected error: " + e:GetErrorMessage()
        end
        check
            output "early:IsBefore(late) = " + early:IsBefore(late)
        detect e
            output "early:IsBefore(late) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "late:IsBefore(early) = " + late:IsBefore(early)
        detect e
            output "late:IsBefore(early) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "early:IsBefore(same) = " + early:IsBefore(same)
        detect e
            output "early:IsBefore(same) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "late:IsAfter(early) = " + late:IsAfter(early)
        detect e
            output "late:IsAfter(early) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "early:IsAfter(late) = " + early:IsAfter(late)
        detect e
            output "early:IsAfter(late) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "early:IsAfter(same) = " + early:IsAfter(same)
        detect e
            output "early:IsAfter(same) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "early:Compare(late) = " + early:Compare(late)
        detect e
            output "early:Compare(late) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "late:Compare(early) = " + late:Compare(early)
        detect e
            output "late:Compare(early) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "early:Compare(same) = " + early:Compare(same)
        detect e
            output "early:Compare(same) unexpected error: " + e:GetErrorMessage()
        end
        DateTime old
        DateTime newer
        check
            old:ParseDate("1900-01-01")
            newer:ParseDate("2100-12-31")
            output "1900-01-01:IsBefore(2100-12-31) = " + old:IsBefore(newer)
            output "2100-12-31:IsAfter(1900-01-01) = " + newer:IsAfter(old)
            output "2100-12-31:Compare(1900-01-01) = " + newer:Compare(old)
        detect e
            output "1900 and 2100 comparisons unexpected error: " + e:GetErrorMessage()
        end
    end
end
