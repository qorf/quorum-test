New DateFormat: GetPattern() = [MMMM d, yyyy], ToText(2026-11-03) = [November 3, 2026]
SetPattern(MM/dd/yyyy): ToText(2026-11-03) = [11/03/2026]
SetPattern(M/d/yy): ToText(2026-11-03) = [11/3/26]
SetPattern(yyyy-MM-dd): ToText(2026-11-03) = [2026-11-03]
SetPattern(EEEE, MMMM d, yyyy): ToText(2026-11-03) = [Tuesday, November 3, 2026]
SetPattern(EEE d MMM yyyy): ToText(2026-11-03) = [Tue 3 Nov 2026]
SetPattern('Day' d 'of' MMMM): ToText(2026-11-03) = [Day 3 of November]
SetPattern(d MMMM ''yy): ToText(2026-11-03) = [3 November '26]
SetPattern(yyyyMMdd): ToText(2026-11-03) = [20261103]
SetPattern(dd.MM.yyyy): ToText(2026-11-03) = [03.11.2026]
SetPattern(yyyy-MM-dd): ToText(0987-06-05) = [0987-06-05]
SetPattern(yy): ToText(0987-06-05) = [87]
SetPattern(yy/M/d): ToText(2005-01-09) = [05/1/9]
ToText(undefined date) = []
SetPattern(undefined): GetPattern() = [], ToText(2026-11-03) = []
GetLongFormat(): GetPattern() = [MMMM d, yyyy], ToText(2026-11-03) = [November 3, 2026]
GetNumericFormat(): GetPattern() = [MM/dd/yyyy], ToText(2026-11-03) = [11/03/2026]
GetISOFormat(): GetPattern() = [yyyy-MM-dd], ToText(2026-11-03) = [2026-11-03]
