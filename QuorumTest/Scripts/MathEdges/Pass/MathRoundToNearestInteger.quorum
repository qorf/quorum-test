use Libraries.Compute.Math

/*
Math:RoundToNearestInteger. A midpoint rounds to the even integer, as
Java's Math.rint and the documentation say: 2.5 gives 2, 3.5 gives 4, -2.5
gives -2 and -3.5 gives -4. (Round rounds midpoints up instead.)
*/
class Main
    Math math

    action Main
        Show(11.932356)
        Show(2.4)
        Show(2.6)
        Show(2.5)
        Show(3.5)
        Show(-2.5)
        Show(-3.5)
        Show(-2.6)
        Show(4.0)
    end

    action Show(number value)
        check
            output "RoundToNearestInteger(" + value + ") = " + math:RoundToNearestInteger(value)
        detect e
            output "RoundToNearestInteger(" + value + ") unexpected error: " + e:GetErrorMessage()
        end
    end
end
