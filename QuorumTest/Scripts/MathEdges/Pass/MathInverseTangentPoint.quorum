use Libraries.Compute.Math

/*
Math:InverseTangent(x, y), the angle of the point (x, y) measured from the
positive x axis, in radians from -pi to pi, as Java's Math.atan2(y, x). The
point (0, 0) gives 0. The sign of a zero counts, as in Java: (-1, 0.0) is
pi and (-1, -0.0) is -pi. (InverseTangent2, the same angle with the values
in the other order, was removed in favor of this action.) Answers are
rounded to 10 places.
*/
class Main
    Math math

    action Main
        Show(1, 1)
        Show(1, 0)
        Show(0, 1)
        Show(-1, 0)
        Show(0, -1)
        Show(-1, -1)
        Show(1, -1)
        Show(-1, 1)
        Show(2, 3)
        Show(0, 0)
        number negativeZero = -0.0
        Show(-1, negativeZero)
        Show(-1, 0.0)
    end

    action Show(number x, number y)
        check
            output "InverseTangent(" + x + ", " + y + ") = " + math:Round(math:InverseTangent(x, y), 10)
        detect e
            output "InverseTangent(" + x + ", " + y + ") unexpected error: " + e:GetErrorMessage()
        end
    end
end
