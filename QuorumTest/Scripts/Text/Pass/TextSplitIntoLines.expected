SplitIntoLines([a/nb]) = 2 lines [a][b]
Text SplitIntoLines([a/nb]) = 2 lines [a][b]
SplitIntoLines([a/nb/n]) = 2 lines [a][b]
Text SplitIntoLines([a/nb/n]) = 2 lines [a][b]
SplitIntoLines([a/n/nb]) = 3 lines [a][][b]
Text SplitIntoLines([a/n/nb]) = 3 lines [a][][b]
SplitIntoLines([/na]) = 2 lines [][a]
Text SplitIntoLines([/na]) = 2 lines [][a]
SplitIntoLines([/n/n]) = 2 lines [][]
Text SplitIntoLines([/n/n]) = 2 lines [][]
SplitIntoLines([/n]) = 1 lines []
Text SplitIntoLines([/n]) = 1 lines []
SplitIntoLines([abc]) = 1 lines [abc]
Text SplitIntoLines([abc]) = 1 lines [abc]
SplitIntoLines([]) = 1 lines []
Text SplitIntoLines([]) = 1 lines []
SplitIntoLines([one line/ntwo words/n  three  ]) = 3 lines [one line][two words][  three  ]
Text SplitIntoLines([one line/ntwo words/n  three  ]) = 3 lines [one line][two words][  three  ]
