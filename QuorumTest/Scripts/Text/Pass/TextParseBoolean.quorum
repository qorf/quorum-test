/*
    Text:ParseBoolean gives the boolean in the text. As documented (and as
    Java's Boolean.parseBoolean does), "true" in any mix of upper and lower
    case gives true, and any other text gives false without an error.
    Each case runs on a text primitive and on a Text object.
*/
class Main
    action Main
        Show("true")
        Show("True")
        Show("TRUE")
        Show("false")
        Show("abc")
        Show("")
        Show(" true")
        Show("yes")
        Show("1")
        Show("0")
    end

    action Show(text value)
        text call = "ParseBoolean([" + value + "])"
        check
            output call + " = " + value:ParseBoolean()
        detect e
            output call + " unexpected error: " + e:GetErrorMessage()
        end
        Text object
        object:SetValue(value)
        check
            output "Text " + call + " = " + object:ParseBoolean()
        detect e
            output "Text " + call + " unexpected error: " + e:GetErrorMessage()
        end
    end
end
