/*
    Text:ParseBoolean gives the boolean in the text, and the documentation
    says that a text that is not a boolean alerts an error. So "true" and
    "false" parse, and other text fails rather than giving false. (Java's
    Boolean.parseBoolean returns false for any other text, which does not
    match the documentation.) Upper case forms are not tested, because the
    documentation does not say whether they are valid.
    Each case runs on a text primitive and on a Text object.
*/
class Main
    action Main
        Show("true")
        Show("false")
        Fail("abc")
        Fail("")
        Fail(" true")
        Fail("yes")
        Fail("1")
        Fail("0")
    end

    action Show(text value)
        text call = "ParseBoolean([" + value + "])"
        check
            output call + " = " + value:ParseBoolean()
        detect e
            output call + " unexpected error: " + e:GetErrorMessage()
        end
        Text object
        object:SetValue(value)
        check
            output "Text " + call + " = " + object:ParseBoolean()
        detect e
            output "Text " + call + " unexpected error: " + e:GetErrorMessage()
        end
    end

    action Fail(text value)
        text call = "ParseBoolean([" + value + "])"
        check
            boolean result = value:ParseBoolean()
            output call + " should fail but returned " + result
        detect e
            output call + " fails, as it should"
        end
        Text object
        object:SetValue(value)
        check
            boolean result = object:ParseBoolean()
            output "Text " + call + " should fail but returned " + result
        detect e
            output "Text " + call + " fails, as it should"
        end
    end
end
