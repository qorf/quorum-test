Split([a,b,c] on [,]) = 3 pieces [a][b][c]
Text Split([a,b,c] on [,]) = 3 pieces [a][b][c]
Split([a,b,,,] on [,]) = 2 pieces [a][b]
Text Split([a,b,,,] on [,]) = 2 pieces [a][b]
Split([a,b,] on [,]) = 2 pieces [a][b]
Text Split([a,b,] on [,]) = 2 pieces [a][b]
Split([,a] on [,]) = 2 pieces [][a]
Text Split([,a] on [,]) = 2 pieces [][a]
Split([,,a] on [,]) = 3 pieces [][][a]
Text Split([,,a] on [,]) = 3 pieces [][][a]
Split([,] on [,]) = 0 pieces 
Text Split([,] on [,]) = 0 pieces 
Split([abc] on [,]) = 1 pieces [abc]
Text Split([abc] on [,]) = 1 pieces [abc]
Split([] on [,]) = 1 pieces []
Text Split([] on [,]) = 1 pieces []
Split([a.b.c] on [.]) = 3 pieces [a][b][c]
Text Split([a.b.c] on [.]) = 3 pieces [a][b][c]
Split([a+b] on [+]) = 2 pieces [a][b]
Text Split([a+b] on [+]) = 2 pieces [a][b]
Split([a|b] on [|]) = 2 pieces [a][b]
Text Split([a|b] on [|]) = 2 pieces [a][b]
Split([a*b] on [*]) = 2 pieces [a][b]
Text Split([a*b] on [*]) = 2 pieces [a][b]
Split([a--b--c] on [--]) = 3 pieces [a][b][c]
Text Split([a--b--c] on [--]) = 3 pieces [a][b][c]
Split([a b  c] on [ ]) = 4 pieces [a][b][][c]
Text Split([a b  c] on [ ]) = 4 pieces [a][b][][c]
Split([aaa] on [aa]) = 2 pieces [][a]
Text Split([aaa] on [aa]) = 2 pieces [][a]
Split([abc] on []) = 1 pieces [abc]
Text Split([abc] on []) = 1 pieces [abc]
