use Libraries.Containers.Array

/*
    Text:SplitIntoLines splits into lines. A line ends at a line feed or at
    a carriage return and line feed (the carriage return is not part of
    the line), so a file gives the same lines whichever machine saved it.
    Empty lines are kept, a final line ending doesn't start an empty line,
    and an empty text gives one empty line. A lone carriage return is not
    a line ending and stays in the line. Labels and results write a line
    feed as /n and a carriage return as /r. Each case runs on a text
    primitive and on a Text object.
*/
class Main
    action Main
        text lf = ""
        lf = lf:GetLineFeed()
        Show("a" + lf + "b", "a/nb")
        Show("a" + lf + "b" + lf, "a/nb/n")
        Show("a" + lf + lf + "b", "a/n/nb")
        Show(lf + "a", "/na")
        Show(lf + lf, "/n/n")
        Show(lf, "/n")
        Show("abc", "abc")
        Show("", "")
        Show("one line" + lf + "two words" + lf + "  three  ", "one line/ntwo words/n  three  ")
        text cr = lf:GetCarriageReturn()
        Show("a" + cr + lf + "b", "a/r/nb")
        Show("a" + cr + lf + "b" + cr + lf, "a/r/nb/r/n")
        Show("a" + cr + lf + cr + lf + "b", "a/r/n/r/nb")
        Show("a" + cr + lf + "b" + lf + "c", "a/r/nb/nc")
        Show(cr + lf, "/r/n")
        Show("a" + cr + "b", "a/rb")
        Show("a" + cr, "a/r")
        Show("a" + cr + cr + lf + "b", "a/r/r/nb")
    end

    action Show(text value, text label)
        text call = "SplitIntoLines([" + label + "])"
        check
            Array<text> lines = value:SplitIntoLines()
            output call + " = " + Pieces(lines)
        detect e
            output call + " unexpected error: " + e:GetErrorMessage()
        end
        Text object
        object:SetValue(value)
        check
            Array<text> lines = object:SplitIntoLines()
            output "Text " + call + " = " + Pieces(lines)
        detect e
            output "Text " + call + " unexpected error: " + e:GetErrorMessage()
        end
    end

    action Pieces(Array<text> pieces) returns text
        text result = "" + pieces:GetSize() + " lines "
        integer i = 0
        repeat while i < pieces:GetSize()
            text piece = pieces:Get(i)
            result = result + "[" + piece:Replace(piece:GetCarriageReturn(), "/r") + "]"
            i = i + 1
        end
        return result
    end
end
