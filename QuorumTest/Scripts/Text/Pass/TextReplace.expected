Replace(hello, l, z) = [hezzo]
Replace(aaaa, a, b) = [bbbb]
Replace(aaaa, aa, b) = [bb]
Replace(banana, an, AN) = [bANANa]
Replace(hello, x, y) = [hello]
Replace(hello, hello, ) = []
Replace(, a, b) = []
Replace(a.b.c, ., -) = [a-b-c]
Replace(one two  three,  , _) = [one_two__three]
Replace(abcabc, abc, abcabc) = [abcabcabcabc]
