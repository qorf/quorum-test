Text Replace(hello, l, z) = [hezzo]
Text Replace(aaaa, a, b) = [bbbb]
Text Replace(aaaa, aa, b) = [bb]
Text Replace(banana, an, AN) = [bANANa]
Text Replace(hello, x, y) = [hello]
Text Replace(hello, hello, ) = []
Text Replace(, a, b) = []
Text Replace(a.b.c, ., -) = [a-b-c]
Text Replace(one two  three,  , _) = [one_two__three]
Text Replace(abcabc, abc, abcabc) = [abcabcabcabc]
Text Replace(a+b+c, +, ) = [abc]
Text Replace((a)(b), )(, , ) = [(a, b)]
