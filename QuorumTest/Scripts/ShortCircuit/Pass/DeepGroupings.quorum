    action Show(text expression, integer which)
        text values = ""
        text choices = ""
        integer i = 0
        repeat while i < 64
            values = values + Letter(Value(which, Bit(i, 0), Bit(i, 1), Bit(i, 2), Bit(i, 3), Bit(i, 4), Bit(i, 5)))
            choices = choices + Letter(Choice(which, Bit(i, 0), Bit(i, 1), Bit(i, 2), Bit(i, 3), Bit(i, 4), Bit(i, 5)))
            i = i + 1
        end
        output expression + ": value " + values + ", if " + choices
    end

    action Value(integer which, boolean a, boolean b, boolean c, boolean d, boolean e, boolean f) returns boolean
        if which = 0
            boolean result = (d or not (f and a)) and (c and (((a or d) and e) or (e or a)))
            return result
        elseif which = 1
            boolean result = ((not (c and (f or f)) or (f or e)) or (f and f)) and not (f or a)
            return result
        elseif which = 2
            boolean result = not (not ((e or c) and (f or b)) and (d and a))
            return result
        elseif which = 3
            boolean result = not ((d and (d and (e or c))) or (c and d))
            return result
        elseif which = 4
            boolean result = (f or (b or (b or c))) and (f and (f and (f and a)))
            return result
        elseif which = 5
            boolean result = d or ((d or e) or (b or (f and c)))
            return result
        elseif which = 6
            boolean result = (f or c) or (((a and b) and f) and ((f and f) and e))
            return result
        elseif which = 7
            boolean result = (d and d) and (((e and (b or a)) or f) or (c or b))
            return result
        elseif which = 8
            boolean result = not (((b or e) and e) and ((f or c) or a))
            return result
        elseif which = 9
            boolean result = ((d and e) and (c and a)) or (e or c)
            return result
        elseif which = 10
            boolean result = (((e and b) and c) and (c and e)) and not ((a and a) or (d or a))
            return result
        elseif which = 11
            boolean result = (b or (a or (c or e))) or (c and c)
            return result
        elseif which = 12
            boolean result = (((a and (d and f)) and c) or (e and b)) or b
            return result
        elseif which = 13
            boolean result = (d and c) or (((e and b) and d) or (not (a and (f or c)) and b))
            return result
        elseif which = 14
            boolean result = ((e or a) and not ((d and (f and e)) or d)) and d
            return result
        elseif which = 15
            boolean result = ((e and (a and e)) or ((f or a) or f)) or (a or (e or a))
            return result
        elseif which = 16
            boolean result = a and ((e and (((c and a) and b) and f)) or a)
            return result
        elseif which = 17
            boolean result = (((f and a) or (d or b)) and a) or ((a or f) or not (e or c))
            return result
        elseif which = 18
            boolean result = ((d and (e and b)) and (a and (d or b))) and (c and b)
            return result
        elseif which = 19
            boolean result = not (b and b) and (a and ((e and b) or ((f and a) or b)))
            return result
        elseif which = 20
            boolean result = ((b and not ((c or (b and d)) and (d or f))) or f) or (c and e)
            return result
        elseif which = 21
            boolean result = (a and c) or (a and (d or (b or a)))
            return result
        elseif which = 22
            boolean result = ((a or (c or a)) or d) and (((d and e) and f) or b)
            return result
        elseif which = 23
            boolean result = ((not ((f and a) and f) and b) and ((a and d) and c)) and (d or d)
            return result
        elseif which = 24
            boolean result = ((b and d) or (d and ((f and d) and b))) or (e or e)
            return result
        elseif which = 25
            boolean result = (d and (f or b)) or (f or (((c and f) or (b and b)) and f))
            return result
        elseif which = 26
            boolean result = not (((a and ((f or (a and c)) and b)) and (b or c)) or not (f or d))
            return result
        elseif which = 27
            boolean result = not (c and a) or (not ((c and (b or e)) and f) or (d or a))
            return result
        elseif which = 28
            boolean result = not ((c or a) and not ((a and a) or ((f and (f or d)) or not (e and e))))
            return result
        elseif which = 29
            boolean result = ((not (b and b) or f) or (d and d)) or a
            return result
        elseif which = 30
            boolean result = not ((b or d) and ((a or (d or b)) and not (a or f)))
            return result
        elseif which = 31
            boolean result = e or not ((d and f) and ((c or b) or b))
            return result
        elseif which = 32
            boolean result = not (((b and c) and c) or (e or (a and ((b and a) and c))))
            return result
        elseif which = 33
            boolean result = not (b or (b or (e and e))) and ((f and e) or b)
            return result
        elseif which = 34
            boolean result = (not (e and e) and ((e or f) or (c and not (f or not (d and c))))) or b
            return result
        elseif which = 35
            boolean result = not (((a or c) or f) or (d and ((f or b) and c)))
            return result
        elseif which = 36
            boolean result = d and ((not (e and ((c or d) or d)) or ((a or d) or b)) and e)
            return result
        elseif which = 37
            boolean result = not ((b and ((c or e) or (c or c))) and (c and d))
            return result
        elseif which = 38
            boolean result = not ((a and (a or f)) or ((f and e) or (c or (d and a))))
            return result
        elseif which = 39
            boolean result = (((c or e) or ((b or d) or e)) and ((c and e) and b)) and c
            return result
        elseif which = 40
            boolean result = b and ((a and c) or (c or ((f and f) and (b and d))))
            return result
        elseif which = 41
            boolean result = not (((e or b) or (((e or b) or f) and a)) or ((e and a) and b))
            return result
