    /* One line: the expression, then its value and the if's choice for each combination, a, b, c, d, e first. */
    action Show(text expression, integer which)
        text values = ""
        text choices = ""
        integer i = 0
        repeat while i < 32
            values = values + Letter(Value(which, Bit(i, 0), Bit(i, 1), Bit(i, 2), Bit(i, 3), Bit(i, 4)))
            choices = choices + Letter(Choice(which, Bit(i, 0), Bit(i, 1), Bit(i, 2), Bit(i, 3), Bit(i, 4)))
            i = i + 1
        end
        output expression + ": value " + values + ", if " + choices
    end

    action Value(integer which, boolean a, boolean b, boolean c, boolean d, boolean e) returns boolean
        if which = 0
            boolean result = a and (b and (c and (d and e)))
            return result
        elseif which = 1
            boolean result = a or (b and (c and (d and e)))
            return result
