    action Show(text expression, integer which)
        text values = ""
        text choices = ""
        integer i = 0
        repeat while i < 16
            values = values + Letter(Value(which, Bit(i, 0), Bit(i, 1), Bit(i, 2), Bit(i, 3)))
            choices = choices + Letter(Choice(which, Bit(i, 0), Bit(i, 1), Bit(i, 2), Bit(i, 3)))
            i = i + 1
        end
        output expression + ": value " + values + ", if " + choices
    end

