    action Show(text expression, integer which)
        text entries = ""
        integer i = 0
        repeat while i < 32
            log = ""
            boolean result = Value(which, Bit(i, 0), Bit(i, 1), Bit(i, 2), Bit(i, 3), Bit(i, 4))
            if i > 0
                entries = entries + " "
            end
            entries = entries + Letter(result) + "/" + log
            i = i + 1
        end
        output expression + ": " + entries
    end

    action Value(integer which, boolean a, boolean b, boolean c, boolean d, boolean e) returns boolean
        if which = 0
            boolean result = A(a) and (B(b) and (C(c) and (D(d) and E(e))))
            return result
        elseif which = 1
            boolean result = A(a) or (B(b) and (C(c) and (D(d) and E(e))))
            return result
        elseif which = 2
            boolean result = A(a) and (B(b) or (C(c) and (D(d) and E(e))))
            return result
        elseif which = 3
            boolean result = A(a) or (B(b) or (C(c) and (D(d) and E(e))))
            return result
        elseif which = 4
            boolean result = A(a) and (B(b) and (C(c) or (D(d) and E(e))))
            return result
        elseif which = 5
            boolean result = A(a) or (B(b) and (C(c) or (D(d) and E(e))))
