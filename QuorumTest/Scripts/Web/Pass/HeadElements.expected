Comment SetDescription(note) Generate() = [<!--note//-->]
Comment SetCommentClose(false) Generate() = [<!--note-->]
Comment GetDescription() and GetCommentClose() = [note true]
DocumentType default Generate() = [<!DOCTYPE html>]
DocumentType SetToHTML4Strict() Generate() = [<!DOCTYPE HTML PUBLIC '-//W3C//DTD HTML 4.01//EN' 'http://www.w3.org/TR/html4/strict.dtd'>]
DocumentType SetToHTML4Strict() then SetToHTML5() Generate() = [<!DOCTYPE html>]
Script SetCode(go();) Generate() = [<script  type='text/javascript'>go();</script>]
Script SetCode(go();) GetCode() = [go();]
Script SetGenerateType(false) Generate() = [<script ></script>]
Script SetAsync(true) IsAsync() and Generate() = [true <script async ></script>]
Script SetDefer(true) GetDefer() = true
Script SetAddress(a.js) GetAddress():Generate() = [src= 'a.js']
Script SetCharSet(UTF-8) GetCharSet():Generate() = [charset= 'UTF-8']
Style AddText(p{color:red}) Generate() = [<style >p{color:red}</style>]
Style SetMedia(print) GetMedia():Generate() = [media= 'print']
Style SetScoped(true) GetScoped() = true
Title AddText(Home) Generate() = [<title >Home</title>]
MetaData SetCharacterSet(UTF-8) Generate() = [<meta charset= 'UTF-8' >]
MetaData SetName(viewport) GetName():Generate() = [name= 'viewport']
MetaData SetContent(width=device-width) GetContent():Generate() = [content= 'width=device-width']
MetaData SetHeaderInformation(refresh) GetHeaderInformation():Generate() = [http-equiv= 'refresh']
new HeaderLink GetRelationship():Generate() = [rel= 'stylesheet']
new HeaderLink GetType():Generate() = [type= 'text/css']
HeaderLink SetAddress(s.css) GetAddress():Generate() = [href= 's.css']
HeaderLink SetRelationship(icon) GetRelationship():Generate() = [rel= 'icon']
HeaderLink SetLinkedResourceSize(16x16) GetLinkedResourceSize():Generate() = [sizes= '16x16']
HeaderLink new GetNumberOfAttributes() = 2
