/*
Tests that each element class with content writes its own HTML tag,
its attributes and its content, with an end tag (HTML Living Standard).
*/
class Main
    action Main
        check
            Audio audio
            audio:AddText("words")
            output "Audio with AddText(words) Generate() = [" + Flat(audio:Generate()) + "]"
        detect e
            output "Audio with AddText(words) Generate() unexpected error: " + e:GetErrorMessage()
        end
        check
            Audio audio
            audio:SetIdentifier("x")
            audio:AddText("words")
            output "Audio with SetIdentifier(x) and AddText(words) Generate() = [" + Flat(audio:Generate()) + "]"
        detect e
            output "Audio with SetIdentifier(x) and AddText(words) Generate() unexpected error: " + e:GetErrorMessage()
