/*
Tests that each flow and phrasing element class writes its own HTML tag
with its attributes, its content and an end tag (HTML Living Standard),
and that a heading's scale is 1 to 6 (Heading:SetScale's documentation).
These classes reach WebPage, and through it the statistics and interface
libraries.
*/
class Main
    action Main
        check
            Abbreviation abbreviationElement
            abbreviationElement:SetIdentifier("x")
            abbreviationElement:AddText("words")
            output "Abbreviation with SetIdentifier(x) and AddText(words) Generate() = [" + Flat(abbreviationElement:Generate()) + "]"
        detect e
            output "Abbreviation with SetIdentifier(x) and AddText(words) Generate() unexpected error: " + e:GetErrorMessage()
        end
        check
            Article articleElement
            articleElement:SetIdentifier("x")
            articleElement:AddText("words")
