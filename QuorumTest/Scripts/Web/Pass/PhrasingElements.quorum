            Heading h
            h:SetScale(0)
            output "Heading SetScale(0) should fail but returned [" + h:GetScale() + "]"
        detect e
            output "Heading SetScale(0) fails, as it should"
        end
    end

    /* Shows line breaks as the two characters \n and double quotes as ', so each case is one line. */
    action Flat(text value) returns text
        text lf = ""
        lf = lf:GetLineFeed()
        text cr = ""
        cr = cr:GetCarriageReturn()
        text quote = ""
        quote = quote:GetDoubleQuote()
        text result = value:Replace(cr, "")
        result = result:Replace(lf, "\n")
        return result:Replace(quote, "'")
    end
end
