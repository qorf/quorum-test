SetLineHeight(40) Generate() = [line-height:2.5rem;]
SetBold(true) Generate() and IsBold() = [font-weight:700; true]
SetBold(false) Generate() = [font-weight:400;]
SetSemibold(true) Generate() = [font-weight:600;]
SetItalic(true) Generate() and IsItalic() = [font-style:italic; true]
UseSurroundingFont() Generate() and UsesSurroundingFont() = [font-family:inherit; true]
