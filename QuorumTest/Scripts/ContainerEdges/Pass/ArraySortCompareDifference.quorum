use Libraries.Containers.Array
use Libraries.Containers.Support.Comparison

/*
    A Comparison whose Compare returns left - right (any negative number for
    smaller, any positive number for larger), a common way to write a
    comparison. The Comparison documentation names -1, 0 and 1; this test
    takes the documented intent (negative = the left item is smaller) to
    cover every negative and positive value, as Java's Comparator does. That
    is a judgment call: if -1/0/1 is meant to be a strict contract, drop it.
*/
class Main is Comparison
    action Compare(Object left, Object right) returns integer
        Integer l = cast(Integer, left)
        Integer r = cast(Integer, right)
        return l:GetValue() - r:GetValue()
    end

    action DescribeNumbers(Array<integer> array) returns text
        text result = "["
        integer i = 0
        repeat while i < array:GetSize()
            if i > 0
                result = result + ","
            end
            result = result + array:Get(i)
            i = i + 1
        end
        return result + "]"
    end

    action Main
        Array<integer> numbers
        numbers:Add(30)
        numbers:Add(10)
        numbers:Add(20)
        numbers:Add(5)
        numbers:Add(10)
        check
            numbers:Sort(me)
            output "Array[30,10,20,5,10] Sort(Compare = left - right) gives " + DescribeNumbers(numbers)
        detect e
            output "Array[30,10,20,5,10] Sort(Compare = left - right) unexpected error: " + e:GetErrorMessage()
        end

        Array<integer> pair
        pair:Add(1)
        pair:Add(3)
        check
            pair:Sort(me)
            output "Array[1,3] Sort(Compare = left - right, so Compare(1, 3) = -2) gives " + DescribeNumbers(pair)
        detect e
            output "Array[1,3] Sort(Compare = left - right) unexpected error: " + e:GetErrorMessage()
        end
    end
end
