use Libraries.Containers.HashTable
use Libraries.Containers.Array

/*
    Undefined keys and undefined values. The HashTable code ignores Add and
    Set with an undefined key and checks for an undefined key in GetValue and
    HasKey, so the intent is clear: an undefined key is never stored, lookups
    with it return undefined or false, and removals with it remove nothing.
    An undefined value may be stored under a real key.
*/
class Main
    action Show(text value) returns text
        if value = undefined
            return "undefined"
        end
        return "[" + value + "]"
    end

    action Describe(Array<text> array) returns text
        text result = "["
        integer i = 0
        repeat while i < array:GetSize()
            if i > 0
                result = result + ","
            end
            text value = array:Get(i)
            if value = undefined
                result = result + "undefined"
            else
                result = result + value
            end
            i = i + 1
        end
        return result + "]"
    end

    // The keys sorted, so the output does not depend on hash order.
    action SortedKeys(HashTable<text, text> table) returns text
        Array<text> keys = table:CopyToKeyArray()
        keys:Sort()
        return Describe(keys)
    end

    action Main
        HashTable<text, text> table
        table:Add("a", "1")
        check
            table:Add(undefined, "2")
            output "HashTable{a:1} Add(undefined, 2): size " + table:GetSize() + ", keys " + SortedKeys(table)
        detect e
            output "HashTable{a:1} Add(undefined, 2) unexpected error: " + e:GetErrorMessage()
        end
        check
            table:Set(undefined, "3")
            output "HashTable{a:1} Set(undefined, 3): size " + table:GetSize() + ", keys " + SortedKeys(table)
        detect e
            output "HashTable{a:1} Set(undefined, 3) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "HashTable{a:1} GetValue(undefined) = " + Show(table:GetValue(undefined))
        detect e
            output "HashTable{a:1} GetValue(undefined) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "HashTable{a:1} HasKey(undefined) = " + table:HasKey(undefined)
        detect e
            output "HashTable{a:1} HasKey(undefined) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "HashTable{a:1} RemoveKey(undefined) = " + Show(table:RemoveKey(undefined)) + ", size " + table:GetSize()
        detect e
            output "HashTable{a:1} RemoveKey(undefined) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "HashTable{a:1} RemoveAllKeys(undefined) = " + table:RemoveAllKeys(undefined) + ", size " + table:GetSize()
        detect e
            output "HashTable{a:1} RemoveAllKeys(undefined) unexpected error: " + e:GetErrorMessage()
        end

        HashTable<text, text> values
        check
            values:Add("k", undefined)
            output "HashTable{} Add(k, undefined): size " + values:GetSize() + ", HasKey(k) = " + values:HasKey("k") + ", GetValue(k) = " + Show(values:GetValue("k"))
        detect e
            output "HashTable{} Add(k, undefined) unexpected error: " + e:GetErrorMessage()
        end
        check
            values:Add("j", "v")
            output "HashTable{k:undefined, j:v} HasValue(v) = " + values:HasValue("v") + ", GetKey(v) = " + Show(values:GetKey("v"))
        detect e
            output "HashTable{k:undefined, j:v} HasValue(v) unexpected error: " + e:GetErrorMessage()
        end
        check
            output "HashTable{k:undefined, j:v} HasValue(w) = " + values:HasValue("w")
        detect e
            output "HashTable{k:undefined, j:v} HasValue(w) unexpected error: " + e:GetErrorMessage()
        end
        check
            text removed = values:RemoveKey("k")
            output "HashTable{k:undefined, j:v} RemoveKey(k) = " + Show(removed) + ", size " + values:GetSize() + ", HasKey(k) = " + values:HasKey("k")
        detect e
            output "HashTable{k:undefined, j:v} RemoveKey(k) unexpected error: " + e:GetErrorMessage()
        end
    end
end
