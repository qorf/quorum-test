use Libraries.Containers.TextTree

/*
    300 Insert, Delete and Concatenate operations at pseudo-random places
    (a fixed linear congruential sequence, the same on every back end) on a
    TextTree, compared after every step with the same edits on a plain text:
    GetText, GetLength, GetCharacter and GetText(start, stop) must agree.
    Run for leaf sizes 1, 3 and 5 (the default), so the tree is split,
    concatenated and rebalanced many times.
*/
class Main
    integer seed = 12345

    action Next(integer limit) returns integer
        seed = (seed * 1103 + 12345) mod 65536
        if limit <= 0
            return 0
        end
        return seed mod limit
    end

    action Run(integer leafSize) returns text
        seed = 12345
        TextTree tree
        tree:Initialize("start", leafSize)
        text plain = "start"
        text letters = "abcdefghijklmnopqrstuvwxyz"
        integer step = 0
        repeat 300 times
            integer kind = Next(3)
            text description = ""
            if kind = 0
                integer at = Next(plain:GetSize() + 1)
                integer start = Next(26)
                integer count = Next(4) + 1
                if start + count > 26
                    start = 26 - count
                end
                text piece = letters:GetSubtext(start, start + count)
                description = "Insert(" + at + ", " + piece + ")"
                tree = tree:Insert(at, piece)
                text before = ""
                if at > 0
                    before = plain:GetSubtext(0, at)
                end
                plain = before + piece + plain:GetSubtext(at, plain:GetSize())
            elseif kind = 1
                integer from = Next(plain:GetSize() + 1)
                integer to = from + Next(plain:GetSize() - from + 1)
                if to - from > 3
                    to = from + 3
                end
                description = "Delete(" + from + ", " + to + ")"
                tree = tree:Delete(from, to)
                text before = ""
                if from > 0
                    before = plain:GetSubtext(0, from)
                end
                plain = before + plain:GetSubtext(to, plain:GetSize())
            else
                integer start = Next(24)
                text piece = letters:GetSubtext(start, start + 2)
                description = "Concatenate(" + piece + ")"
                tree = tree:Concatenate(piece)
                plain = plain + piece
            end
            step = step + 1
            if tree:GetText() not= plain
                return "differs after step " + step + " " + description + ": tree [" + tree:GetText() + "], text [" + plain + "]"
            end
            if tree:GetLength() not= plain:GetSize()
                return "GetLength() wrong after step " + step + " " + description + ": " + tree:GetLength() + ", text length " + plain:GetSize()
            end
            if plain:GetSize() > 0
                integer where = Next(plain:GetSize())
                if tree:GetCharacter(where) not= plain:GetCharacter(where)
                    return "GetCharacter(" + where + ") wrong after step " + step + " " + description + ": [" + tree:GetCharacter(where) + "], text [" + plain:GetCharacter(where) + "]"
                end
                integer stop = where + Next(plain:GetSize() - where + 1)
                if tree:GetText(where, stop) not= plain:GetSubtext(where, stop)
                    return "GetText(" + where + ", " + stop + ") wrong after step " + step + " " + description + ": [" + tree:GetText(where, stop) + "], text [" + plain:GetSubtext(where, stop) + "]"
                end
            end
        end
        return "all 300 steps match the plain text"
    end

    action Main
        integer size = 1
        repeat 3 times
            check
                output "TextTree leaf size " + size + ", 300 random Insert/Delete/Concatenate: " + Run(size)
            detect e
                output "TextTree leaf size " + size + ", 300 random edits unexpected error: " + e:GetErrorMessage()
            end
            size = size + 2
        end
    end
end
