use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
Adding and removing over and over with counted keys (see LookupKeys):
    20 rounds, each adding 2,500 new keys and removing the 2,000 oldest, so
    the table ends with 10,000 keys after 90,000 operations. Removed keys
    must leave no trace: every remaining key is found, every removed one is
    gone, the work per operation stays small, and the keys still spread
    over the buckets. No timing.
*/
class Main

    // Spread: with well spread hash codes the items fill many buckets. A
    // table that resizes at three items per four buckets uses about 0.75
    // to 0.85 buckets per item; keys that all hash alike would use one.
    action Spread(text name, integer items, integer bucketsInUse, integer buckets)
        output name + ": buckets in use at least half the items = " + (bucketsInUse * 2 >= items)
        output name + ": at most three items for every four buckets = " + (items * 4 <= buckets * 3)
    end

    action Main
        integer count = 50000
        KeyCounter counter
        Array<CountedKey> keys
        integer i = 0
        repeat count times
            CountedKey key
            key:Setup("item" + i, counter)
            keys:Add(key)
            i = i + 1
        end
        HashTable<CountedKey, integer> table
        integer added = 0
        integer oldest = 0
        repeat 20 times
            repeat 2500 times
                table:Add(keys:Get(added), added)
                added = added + 1
            end
            repeat 2000 times
                integer value = table:RemoveKey(keys:Get(oldest))
                oldest = oldest + 1
            end
        end
        integer operations = 90000
        output "After 20 rounds: GetSize() = " + table:GetSize()
        output "Churn: at most 4 hash codes per operation = " + (counter:GetHashCodes() <= operations * 4)
        output "Churn: at most 2 comparisons per operation on average = " + (counter:GetComparisons() <= operations * 2)
        integer found = 0
        i = oldest
        repeat while i < added
            if table:GetValue(keys:Get(i)) = i
                found = found + 1
            end
            i = i + 1
        end
        integer gone = 0
        i = 0
        repeat while i < oldest
            if not table:HasKey(keys:Get(i))
                gone = gone + 1
            end
            i = i + 1
        end
        output "Every remaining key is found = " + (found = added - oldest) + ", every removed key is gone = " + (gone = oldest)
        Spread("after churn", table:GetSize(), table:GetBucketsInUse(), table:GetBucketCount())
    end
end
