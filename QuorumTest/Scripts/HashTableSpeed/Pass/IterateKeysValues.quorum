use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
Walking a 50,000-key HashTable with counted keys (see LookupKeys): the
    key iterator, the value iterator, CopyToKeyArray and CopyToValueArray
    each visit every item once (the value sums show it) and never ask a
    key for its hash code or compare keys. No timing.
*/
class Main


    action Main
        integer count = 50000
        KeyCounter counter
        Array<CountedKey> keys
        integer i = 0
        repeat count times
            CountedKey key
            key:Setup("item" + i, counter)
            keys:Add(key)
            i = i + 1
        end
        HashTable<CountedKey, integer> table
        i = 0
        repeat count times
            table:Add(keys:Get(i), i)
            i = i + 1
        end
        counter:Reset()
        integer keyCount = 0
        integer keySum = 0
        Iterator<CountedKey> keyIterator = table:GetKeyIterator()
        repeat while keyIterator:HasNext()
            CountedKey key = keyIterator:Next()
            text name = key:GetName()
            keySum = keySum + cast(integer, name:GetSubtext(4))
            keyCount = keyCount + 1
        end
        output "GetKeyIterator visits " + keyCount + " keys, numbers summing to " + keySum
        integer valueCount = 0
        integer valueSum = 0
        Iterator<integer> valueIterator = table:GetValueIterator()
        repeat while valueIterator:HasNext()
            valueSum = valueSum + valueIterator:Next()
            valueCount = valueCount + 1
        end
        output "GetValueIterator visits " + valueCount + " values summing to " + valueSum
        Array<CountedKey> keyArray = table:CopyToKeyArray()
        Array<integer> valueArray = table:CopyToValueArray()
        output "CopyToKeyArray GetSize() = " + keyArray:GetSize() + ", CopyToValueArray GetSize() = " + valueArray:GetSize()
        output "Walking: hash codes = " + counter:GetHashCodes() + ", comparisons = " + counter:GetComparisons()
    end
end
