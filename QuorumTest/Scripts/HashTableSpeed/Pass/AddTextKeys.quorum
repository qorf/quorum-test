use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
HashTable with 100,000 short text keys ("key0" to "key99999"). Checks
    the size, that every key gives back its value, and the spread of the
    keys over the table's buckets. No timing: the spread and the counts
    are the same on every machine, and keys that all land in a few buckets
    (the slow case) show up as too few buckets in use.
*/
class Main

    // Spread: with well spread hash codes the items fill many buckets. A
    // table that resizes at three items per four buckets uses about 0.75
    // to 0.85 buckets per item; keys that all hash alike would use one.
    action Spread(text name, integer items, integer bucketsInUse, integer buckets)
        output name + ": buckets in use at least half the items = " + (bucketsInUse * 2 >= items)
        output name + ": at most three items for every four buckets = " + (items * 4 <= buckets * 3)
    end

    action Main
        integer count = 100000
        HashTable<text, integer> table
        integer i = 0
        repeat count times
            table:Add("key" + i, i)
            i = i + 1
        end
        output "Add 100000 text keys: GetSize() = " + table:GetSize()
        integer found = 0
        i = 0
        repeat count times
            integer value = table:GetValue("key" + i)
            if value = i
                found = found + 1
            end
            i = i + 1
        end
        output "GetValue finds every key with its value = " + (found = count)
        Spread("100000 text keys", table:GetSize(), table:GetBucketsInUse(), table:GetBucketCount())
    end
end
