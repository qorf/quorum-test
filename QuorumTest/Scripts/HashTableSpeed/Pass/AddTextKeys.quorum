use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.System.DateTime

/*
    Speed of HashTable Add with short text keys ("key0", "key1", ...).
    The keys are made before timing starts, so only Add is timed.
    Limit: 400,000 Adds within 2,000 ms. A decent hash table on the JVM
    does this in well under 200 ms (measured about 90 ms on bytecode), so
    the limit only catches a real problem. Scaling: 100,000 then 400,000.
*/
class Main
    DateTime clock

    action Now returns number
        return clock:GetEpochTime()
    end

    // Prints a fixed line when the time is within the limit, and the
    // measured time only when it is not.
    action Limit(text name, number milliseconds, integer limit)
        if milliseconds <= limit
            output name + ": within " + limit + " ms"
        else
            output name + ": too slow, " + cast(integer, milliseconds) + " ms (limit " + limit + " ms)"
        end
    end

    // Four times the work may take at most eight times as long. A smaller
    // time under 20 ms is too short to measure a ratio reliably (timer
    // granularity, JIT warm-up), so it counts as linear.
    action Scaling(text name, text unit, integer smallCount, number smallTime, integer bigCount, number bigTime)
        if smallTime < 20 or bigTime <= smallTime * 8
            output name + " scales linearly (4x " + unit + ", at most 8x time)"
        else
            number ratio = cast(integer, bigTime / smallTime * 10) / 10.0
            output name + " grows faster than linear: " + smallCount + " in " + cast(integer, smallTime) + " ms, " + bigCount + " in " + cast(integer, bigTime) + " ms (" + ratio + "x)"
        end
    end

    action Keys(integer count) returns Array<text>
        Array<text> keys
        keys:SetMaxSize(count)
        integer i = 0
        repeat count times
            keys:Add("key" + i)
            i = i + 1
        end
        return keys
    end

    action TimeAdds(Array<text> keys, HashTable<text, integer> table) returns number
        integer count = keys:GetSize()
        number start = Now()
        integer i = 0
        repeat count times
            table:Add(keys:Get(i), i)
            i = i + 1
        end
        return Now() - start
    end

    action Main
        Array<text> small = Keys(100000)
        Array<text> big = Keys(400000)
        HashTable<text, integer> smallTable
        HashTable<text, integer> bigTable
        number smallTime = TimeAdds(small, smallTable)
        number bigTime = TimeAdds(big, bigTable)
        output "Add 100000 text keys: size " + smallTable:GetSize() + ", GetValue(key99999) = " + smallTable:GetValue("key99999")
        output "Add 400000 text keys: size " + bigTable:GetSize() + ", GetValue(key399999) = " + bigTable:GetValue("key399999")
        Limit("Add 400000 text keys", bigTime, 2000)
        Scaling("Add", "keys", 100000, smallTime, 400000, bigTime)
    end
end
