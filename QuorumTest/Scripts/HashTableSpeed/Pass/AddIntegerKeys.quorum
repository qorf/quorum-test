use Libraries.Containers.HashTable
use Libraries.System.DateTime

/*
    Speed of HashTable Add with integer keys: consecutive keys (0, 1, 2...)
    and keys spread by a power of two (i * 1024), which a table that uses
    the low bits of the hash code without mixing would put in few buckets.
    Limits: 400,000 Adds within 2,000 ms for each kind (about 30-40 ms on
    bytecode). Scaling: 100,000 then 400,000.
*/
class Main
    DateTime clock

    action Now returns number
        return clock:GetEpochTime()
    end

    // Prints a fixed line when the time is within the limit, and the
    // measured time only when it is not.
    action Limit(text name, number milliseconds, integer limit)
        if milliseconds <= limit
            output name + ": within " + limit + " ms"
        else
            output name + ": too slow, " + cast(integer, milliseconds) + " ms (limit " + limit + " ms)"
        end
    end

    // Four times the work may take at most eight times as long. A smaller
    // time under 20 ms is too short to measure a ratio reliably (timer
    // granularity, JIT warm-up), so it counts as linear.
    action Scaling(text name, text unit, integer smallCount, number smallTime, integer bigCount, number bigTime)
        if smallTime < 20 or bigTime <= smallTime * 8
            output name + " scales linearly (4x " + unit + ", at most 8x time)"
        else
            number ratio = cast(integer, bigTime / smallTime * 10) / 10.0
            output name + " grows faster than linear: " + smallCount + " in " + cast(integer, smallTime) + " ms, " + bigCount + " in " + cast(integer, bigTime) + " ms (" + ratio + "x)"
        end
    end

    action TimeAdds(integer count, integer step, HashTable<integer, integer> table) returns number
        number start = Now()
        integer i = 0
        repeat count times
            table:Add(i * step, i)
            i = i + 1
        end
        return Now() - start
    end

    action Main
        HashTable<integer, integer> a
        HashTable<integer, integer> b
        number smallTime = TimeAdds(100000, 1, a)
        number bigTime = TimeAdds(400000, 1, b)
        output "Add 100000 consecutive integer keys: size " + a:GetSize() + ", GetValue(99999) = " + a:GetValue(99999)
        output "Add 400000 consecutive integer keys: size " + b:GetSize() + ", GetValue(399999) = " + b:GetValue(399999)
        Limit("Add 400000 consecutive integer keys", bigTime, 2000)
        Scaling("Add consecutive integer keys", "keys", 100000, smallTime, 400000, bigTime)

        HashTable<integer, integer> c
        HashTable<integer, integer> d
        number smallSpread = TimeAdds(100000, 1024, c)
        number bigSpread = TimeAdds(400000, 1024, d)
        output "Add 100000 integer keys i * 1024: size " + c:GetSize() + ", GetValue(1024 * 99999) = " + c:GetValue(1024 * 99999)
        output "Add 400000 integer keys i * 1024: size " + d:GetSize() + ", GetValue(1024 * 399999) = " + d:GetValue(1024 * 399999)
        Limit("Add 400000 integer keys i * 1024", bigSpread, 2000)
        Scaling("Add integer keys i * 1024", "keys", 100000, smallSpread, 400000, bigSpread)
    end
end
