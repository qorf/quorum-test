use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
HashTable with 100,000 integer keys: consecutive (0 to 99,999) and
    spaced (multiples of 1,024, which share their low bits and land in one
    bucket unless the table mixes the hash code). Checks the size, the
    values, and the spread over the buckets. No timing.
*/
class Main

    // Spread: with well spread hash codes the items fill many buckets. A
    // table that resizes at three items per four buckets uses about 0.75
    // to 0.85 buckets per item; keys that all hash alike would use one.
    action Spread(text name, integer items, integer bucketsInUse, integer buckets)
        output name + ": buckets in use at least half the items = " + (bucketsInUse * 2 >= items)
        output name + ": at most three items for every four buckets = " + (items * 4 <= buckets * 3)
    end

    action Main
        integer count = 100000
        HashTable<integer, integer> consecutive
        HashTable<integer, integer> spaced
        integer i = 0
        repeat count times
            consecutive:Add(i, i)
            spaced:Add(i * 1024, i)
            i = i + 1
        end
        output "Add 100000 consecutive integer keys: GetSize() = " + consecutive:GetSize()
        output "Add 100000 spaced integer keys: GetSize() = " + spaced:GetSize()
        integer found = 0
        i = 0
        repeat count times
            if consecutive:GetValue(i) = i and spaced:GetValue(i * 1024) = i
                found = found + 1
            end
            i = i + 1
        end
        output "GetValue finds every key with its value = " + (found = count)
        Spread("consecutive integer keys", consecutive:GetSize(), consecutive:GetBucketsInUse(), consecutive:GetBucketCount())
        Spread("spaced integer keys", spaced:GetSize(), spaced:GetBucketsInUse(), spaced:GetBucketCount())
    end
end
