use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
HashTable RemoveKey with 50,000 counted keys (see LookupKeys). Removing
    every key hashes each once and compares it with about one stored key;
    afterward the table is empty and no bucket is in use. No timing.
*/
class Main


    action Main
        integer count = 50000
        KeyCounter counter
        Array<CountedKey> keys
        integer i = 0
        repeat count times
            CountedKey key
            key:Setup("item" + i, counter)
            keys:Add(key)
            i = i + 1
        end
        HashTable<CountedKey, integer> table
        i = 0
        repeat count times
            table:Add(keys:Get(i), i)
            i = i + 1
        end
        counter:Reset()
        integer removed = 0
        i = 0
        repeat count times
            CountedKey same
            same:Setup("item" + i, counter)
            if table:RemoveKey(same) = i
                removed = removed + 1
            end
            i = i + 1
        end
        output "RemoveKey returns every key's value = " + (removed = count)
        output "RemoveKey: one hash code per key = " + (counter:GetHashCodes() = count)
        output "RemoveKey: at most 2 comparisons per key on average = " + (counter:GetComparisons() <= count * 2)
        output "After removing every key: GetSize() = " + table:GetSize() + ", IsEmpty() = " + table:IsEmpty() + ", buckets in use = " + table:GetBucketsInUse()
    end
end
