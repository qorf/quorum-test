use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
HashTable against an Array and a List holding the same 50,000 counted
    keys (see LookupKeys), by the comparisons each needs to find 100 keys
    spread through the collection. Array and List Has search from the
    front, so finding the key at position p takes p + 1 comparisons
    (2,500,100 in all for these 100); the HashTable needs about one per
    key. All three hold every key. No timing.
*/
class Main


    action Main
        integer count = 50000
        KeyCounter counter
        Array<CountedKey> keys
        integer i = 0
        repeat count times
            CountedKey key
            key:Setup("item" + i, counter)
            keys:Add(key)
            i = i + 1
        end
        List<CountedKey> list
        HashTable<CountedKey, integer> table
        i = 0
        repeat count times
            list:Add(keys:Get(i))
            table:Add(keys:Get(i), i)
            i = i + 1
        end
        output "Array, List and HashTable sizes = " + keys:GetSize() + ", " + list:GetSize() + ", " + table:GetSize()

        counter:Reset()
        integer arrayFound = 0
        integer j = 0
        repeat 100 times
            if keys:Has(keys:Get(j * 500 + 250))
                arrayFound = arrayFound + 1
            end
            j = j + 1
        end
        output "Array Has finds " + arrayFound + " of 100 with " + counter:GetComparisons() + " comparisons"

        counter:Reset()
        integer listFound = 0
        j = 0
        repeat 100 times
            if list:Has(keys:Get(j * 500 + 250))
                listFound = listFound + 1
            end
            j = j + 1
        end
        output "List Has finds " + listFound + " of 100 with " + counter:GetComparisons() + " comparisons"

        counter:Reset()
        integer tableFound = 0
        j = 0
        repeat 100 times
            if table:HasKey(keys:Get(j * 500 + 250))
                tableFound = tableFound + 1
            end
            j = j + 1
        end
        output "HashTable HasKey finds " + tableFound + " of 100 with at most 200 comparisons = " + (counter:GetComparisons() <= 200)
    end
end
