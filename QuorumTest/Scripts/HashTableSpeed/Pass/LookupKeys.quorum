use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
HashTable lookups with 50,000 counted keys: keys that count how often
    the table asks for their hash code and compares them. A well spread
    table hashes each key looked up once and compares it with about one
    stored key; keys that share a few buckets would need thousands of
    comparisons. Checks GetValue and HasKey for keys that are there and
    for keys that aren't, by those counts. No timing.
*/
class Main


    action Main
        integer count = 50000
        KeyCounter counter
        Array<CountedKey> keys
        integer i = 0
        repeat count times
            CountedKey key
            key:Setup("item" + i, counter)
            keys:Add(key)
            i = i + 1
        end
        HashTable<CountedKey, integer> table
        i = 0
        repeat count times
            table:Add(keys:Get(i), i)
            i = i + 1
        end
        output "Add 50000 counted keys: GetSize() = " + table:GetSize()
        output "Add: at most 4 hash codes per key = " + (counter:GetHashCodes() <= count * 4)
        output "Add: at most 2 comparisons per key on average = " + (counter:GetComparisons() <= count * 2)

        counter:Reset()
        integer found = 0
        i = 0
        repeat count times
            CountedKey same
            same:Setup("item" + i, counter)
            if table:GetValue(same) = i
                found = found + 1
            end
            i = i + 1
        end
        output "GetValue finds every key with its value = " + (found = count)
        output "GetValue: one hash code per lookup = " + (counter:GetHashCodes() = count)
        output "GetValue: at most 2 comparisons per lookup on average = " + (counter:GetComparisons() <= count * 2)

        counter:Reset()
        integer present = 0
        i = 0
        repeat count times
            CountedKey same
            same:Setup("item" + i, counter)
            if table:HasKey(same)
                present = present + 1
            end
            i = i + 1
        end
        output "HasKey finds every key = " + (present = count)
        output "HasKey: at most 2 comparisons per lookup on average = " + (counter:GetComparisons() <= count * 2)

        counter:Reset()
        integer missing = 0
        i = 0
        repeat count times
            CountedKey absent
            absent:Setup("other" + i, counter)
            if not table:HasKey(absent)
                missing = missing + 1
            end
            i = i + 1
        end
        output "HasKey of 50000 keys not in the table is false for all = " + (missing = count)
        output "HasKey of missing keys: at most 2 comparisons per lookup on average = " + (counter:GetComparisons() <= count * 2)
    end
end
