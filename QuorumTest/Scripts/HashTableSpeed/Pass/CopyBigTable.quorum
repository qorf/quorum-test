use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
HashTable Copy of a 50,000-key table with counted keys (see
    LookupKeys). Copy duplicates the table's buckets as they are, so it
    never asks a key for its hash code or compares keys, and the copy has
    the same size, buckets and spread. Every key is found in the copy, and
    removing keys from the copy leaves the original whole. No timing.
*/
class Main


    action Main
        integer count = 50000
        KeyCounter counter
        Array<CountedKey> keys
        integer i = 0
        repeat count times
            CountedKey key
            key:Setup("item" + i, counter)
            keys:Add(key)
            i = i + 1
        end
        HashTable<CountedKey, integer> table
        i = 0
        repeat count times
            table:Add(keys:Get(i), i)
            i = i + 1
        end
        counter:Reset()
        HashTable<CountedKey, integer> copy = cast(HashTable<CountedKey, integer>, table:Copy())
        output "Copy: hash codes = " + counter:GetHashCodes() + ", comparisons = " + counter:GetComparisons()
        output "Copy: same size = " + (copy:GetSize() = table:GetSize()) + ", same buckets = " + (copy:GetBucketCount() = table:GetBucketCount()) + ", same buckets in use = " + (copy:GetBucketsInUse() = table:GetBucketsInUse())
        integer found = 0
        i = 0
        repeat count times
            if copy:GetValue(keys:Get(i)) = i
                found = found + 1
            end
            i = i + 1
        end
        output "GetValue on the copy finds every key with its value = " + (found = count)
        i = 0
        repeat 1000 times
            CountedKey removed = keys:Get(i)
            integer value = copy:RemoveKey(removed)
            i = i + 1
        end
        output "After removing 1000 keys from the copy: copy GetSize() = " + copy:GetSize() + ", original GetSize() = " + table:GetSize()
    end
end
