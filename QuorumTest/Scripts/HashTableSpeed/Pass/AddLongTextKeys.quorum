use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.System.DateTime

/*
    Speed of HashTable Add, GetValue and HasKey with long text keys
    ("customer-account-number-0", 25 or more characters), the kind of key
    real programs use. A text hash code must stay a 32-bit integer however
    long the text is: if it is computed in floating point without wrapping
    (31 * h + c), long texts lose their low bits and all hash to the same
    bucket, and every operation turns into a linear search. Sizes are kept
    small (5,000 then 20,000) so a broken hash still finishes.
    Limits: 20,000 Adds within 500 ms and 20,000 lookups within 500 ms
    (about 10 ms each on bytecode).
*/
class Main
    DateTime clock

    action Now returns number
        return clock:GetEpochTime()
    end

    // Prints a fixed line when the time is within the limit, and the
    // measured time only when it is not.
    action Limit(text name, number milliseconds, integer limit)
        if milliseconds <= limit
            output name + ": within " + limit + " ms"
        else
            output name + ": too slow, " + cast(integer, milliseconds) + " ms (limit " + limit + " ms)"
        end
    end

    // Four times the work may take at most eight times as long. A smaller
    // time under 20 ms is too short to measure a ratio reliably (timer
    // granularity, JIT warm-up), so it counts as linear.
    action Scaling(text name, text unit, integer smallCount, number smallTime, integer bigCount, number bigTime)
        if smallTime < 20 or bigTime <= smallTime * 8
            output name + " scales linearly (4x " + unit + ", at most 8x time)"
        else
            number ratio = cast(integer, bigTime / smallTime * 10) / 10.0
            output name + " grows faster than linear: " + smallCount + " in " + cast(integer, smallTime) + " ms, " + bigCount + " in " + cast(integer, bigTime) + " ms (" + ratio + "x)"
        end
    end

    action Keys(integer count) returns Array<text>
        Array<text> keys
        integer i = 0
        repeat count times
            keys:Add("customer-account-number-" + i)
            i = i + 1
        end
        return keys
    end

    action TimeAdds(Array<text> keys, HashTable<text, integer> table) returns number
        number start = Now()
        integer i = 0
        repeat keys:GetSize() times
            table:Add(keys:Get(i), i)
            i = i + 1
        end
        return Now() - start
    end

    action TimeLookups(Array<text> keys, HashTable<text, integer> table) returns number
        number start = Now()
        integer i = 0
        integer found = 0
        repeat keys:GetSize() times
            if table:HasKey(keys:Get(i))
                integer value = table:GetValue(keys:Get(i))
                if value = i
                    found = found + 1
                end
            end
            i = i + 1
        end
        number time = Now() - start
        output "Look up " + keys:GetSize() + " long text keys: found " + found
        return time
    end

    action Main
        Array<text> small = Keys(5000)
        Array<text> big = Keys(20000)
        HashTable<text, integer> smallTable
        HashTable<text, integer> bigTable
        number smallAdd = TimeAdds(small, smallTable)
        number bigAdd = TimeAdds(big, bigTable)
        output "Add 5000 long text keys: size " + smallTable:GetSize()
        output "Add 20000 long text keys: size " + bigTable:GetSize()
        number smallLook = TimeLookups(small, smallTable)
        number bigLook = TimeLookups(big, bigTable)
        Limit("Add 20000 long text keys", bigAdd, 500)
        Scaling("Add long text keys", "keys", 5000, smallAdd, 20000, bigAdd)
        Limit("Look up 20000 long text keys", bigLook, 500)
        Scaling("Look up long text keys", "keys", 5000, smallLook, 20000, bigLook)
    end
end
