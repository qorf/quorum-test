use Libraries.Containers.HashTable
use Libraries.Containers.Array
use Libraries.Containers.List
use Libraries.Containers.Iterator

/*
HashTable with 20,000 long text keys: 1,000 identical characters, then
    a number. Every character must count in the hash code, or these keys
    would share a few buckets. Checks the size, the values, the spread, and
    that text hash codes follow Java's String hash formula (31 times the
    hash so far plus each character, kept to 32 bits) on every back end,
    so a table built on one back end spreads keys the same way on another.
    No timing.
*/
class Main

    // Spread: with well spread hash codes the items fill many buckets. A
    // table that resizes at three items per four buckets uses about 0.75
    // to 0.85 buckets per item; keys that all hash alike would use one.
    action Spread(text name, integer items, integer bucketsInUse, integer buckets)
        output name + ": buckets in use at least half the items = " + (bucketsInUse * 2 >= items)
        output name + ": at most three items for every four buckets = " + (items * 4 <= buckets * 3)
    end

    // Java's String hash code: 31 times the hash so far plus each
    // character, kept to 32 bits (worked out with numbers, so it doesn't
    // depend on how a back end handles integer overflow).
    action JavaHash(text value) returns integer
        number hash = 0
        integer i = 0
        repeat while i < value:GetSize()
            hash = (hash * 31 + value:GetUnicodeInteger(i)) mod 4294967296.0
            i = i + 1
        end
        if hash >= 2147483648.0
            hash = hash - 4294967296.0
        end
        return cast(integer, hash)
    end

    action Main
        text prefix = ""
        integer i = 0
        repeat 1000 times
            prefix = prefix + "x"
        end
        integer count = 20000
        HashTable<text, integer> table
        i = 0
        repeat count times
            table:Add(prefix + i, i)
            i = i + 1
        end
        output "Add 20000 long text keys: GetSize() = " + table:GetSize()
        integer found = 0
        i = 0
        repeat count times
            if table:GetValue(prefix + i) = i
                found = found + 1
            end
            i = i + 1
        end
        output "GetValue finds every key with its value = " + (found = count)
        Spread("20000 long text keys", table:GetSize(), table:GetBucketsInUse(), table:GetBucketCount())

        text hello = "hello"
        output "hello:GetHashCode() = " + hello:GetHashCode()
        text empty = ""
        output "empty text GetHashCode() = " + empty:GetHashCode()
        integer matches = 0
        i = 0
        repeat 100 times
            text key = prefix + i
            if key:GetHashCode() = JavaHash(key)
                matches = matches + 1
            end
            i = i + 1
        end
        output "100 long keys hash as Java's formula = " + (matches = 100)
    end
end
